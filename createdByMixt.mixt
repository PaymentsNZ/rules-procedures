                ]
                w::tblGrid = [
                    w::gridCol = null meta {
                        xml::attributes = {
                            w::w = 1701
                        }
                    }
                    w::gridCol = null meta {
                        xml::attributes = {
                            w::w = 7937
                        }
                    }
                ]
                w::tr = [
                    w::tc = [
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
                                            w::val = 0
                                        }
                                    }
                                    w::numId = null meta {
                                        xml::attributes = {
