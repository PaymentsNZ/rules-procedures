                            w::r = [
                                w::t = "This document HVCS Common Procedures (Part B) is one part of a suite of documentation to help participants understand what is required to become a high value clearing system (HVCS) participant and how to send and receive individual HVCS instructions and NZD HVCS payments that the participant cannot revoke or reverse after settlement."
                            ]
                        ]
                    ]
