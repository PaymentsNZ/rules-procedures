            w::p = [
                w::r = [
                    w::t = "SectionHeading: Chapter 2: Errors"
                ]
            ]
            w::p = [
                w::r = [
                    w::t = "Commentary"
                ]
            ]
            w::tbl = [
                w::tblPr = [
                    w::tblW = null meta {
                        xml::attributes = {
                            w::type = "dxa"
                            w::w = 9638
                        }
                    }
                    w::jc = null meta {
                        xml::attributes = {
                            w::val = "left"
                        }
                    }
                    w::tblInd = null meta {
                        xml::attributes = {
                            w::type = "dxa"
                            w::w = "0"
                        }
                    }
                    w::tblLayout = null meta {
                        xml::attributes = {
                            w::type = "fixed"
                        }
                    }
                ]
                w::tblGrid = [
                    w::gridCol = null meta {
                        xml::attributes = {
                            w::w = 1701
                        }
                    }
                    w::gridCol = null meta {
                        xml::attributes = {
                            w::w = 7937
                        }
                    }
                ]
                w::tr = [
                    w::tc = [
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
                                            w::val = 0
                                        }
                                    }
                                    w::numId = null meta {
                                        xml::attributes = {
                                            w::val = 100
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "2.1 Errors"
                            ]
                        ]
                    ]
                    w::tc = [
                        w::p = [
                            w::r = [
                                w::t = "Sometimes an instructed agent cannot process an HVCS instruction because of, for example, a problem with the content or the format of the instruction or an invalid account number."
                            ]
                        ]
                        w::p = [
                            w::r = [
                                w::t = "If an instructed agent cannot process an HVCS instruction, rule 9.21 and clause 2.2 of these HVCS Common Procedures, provides the instructed agent two options. The instructed agent can either return the HVCS instruction to the instructing agent or the instructed agent can arrange to correct the HVCS instruction."
                            ]
                        ]
                        w::p = [
                            w::r = [
                                w::t = "The following diagram summarises the processes that apply if the HVCS instruction contains an error."
                            ]
                        ]
                    ]
                ]
            ]
            w::p = [
                w::r = [
                    w::t = "Standards"
                ]
            ]
            w::tbl = [
                w::tblPr = [
                    w::tblW = null meta {
                        xml::attributes = {
                            w::type = "dxa"
                            w::w = 9638
                        }
                    }
                    w::jc = null meta {
                        xml::attributes = {
                            w::val = "left"
                        }
                    }
                    w::tblInd = null meta {
                        xml::attributes = {
                            w::type = "dxa"
                            w::w = "0"
                        }
                    }
                    w::tblLayout = null meta {
                        xml::attributes = {
                            w::type = "fixed"
                        }
                    }
                ]
                w::tblGrid = [
                    w::gridCol = null meta {
                        xml::attributes = {
                            w::w = 1701
                        }
                    }
                    w::gridCol = null meta {
                        xml::attributes = {
                            w::w = 7937
                        }
                    }
                ]
                w::tr = [
                    w::tc = [
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
                                            w::val = 0
                                        }
                                    }
                                    w::numId = null meta {
                                        xml::attributes = {
                                            w::val = 100
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "2.2 Error prevents processing"
                            ]
                        ]
                    ]
                    w::tc = [
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
                                            w::val = 1
                                        }
                                    }
                                    w::numId = null meta {
                                        xml::attributes = {
                                            w::val = 100
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "This clause applies to an instructed agent who has received a settled HVCS payment but cannot process the HVCS payment because of an error relating to the HVCS payment."
                            ]
                        ]
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
                                            w::val = 1
                                        }
                                    }
                                    w::numId = null meta {
                                        xml::attributes = {
                                            w::val = 100
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "The instructed agent must do one of the following:"
                            ]
                        ]
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
                                            w::val = 2
                                        }
                                    }
                                    w::numId = null meta {
                                        xml::attributes = {
                                            w::val = 100
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "return the HVCS payment to the instructing agent in accordance with the applicable HVCS standards:"
                            ]
                        ]
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
                                            w::val = 2
                                        }
                                    }
                                    w::numId = null meta {
                                        xml::attributes = {
                                            w::val = 100
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "require the instructing agent to send data to amend the HVCS payment:"
                            ]
                        ]
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
                                            w::val = 2
                                        }
                                    }
                                    w::numId = null meta {
                                        xml::attributes = {
                                            w::val = 100
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "amend the HVCS payment without asking the instructing agent for amended data and, as soon as practicable after amendment is complete, process the HVCS payment."
                            ]
                        ]
                        w::p = [
                            w::pPr = [
                                w::numPr = [
