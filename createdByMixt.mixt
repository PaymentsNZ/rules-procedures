                            w::r = [
                                w::t = "A participant that receives HVCS instructions on behalf of a creditor agent pursuant to an agency arrangement must ensure that each creditor agent which it has an agency arrangement with has a SWIFT BIC to identify the creditor agent that can be provided to the debtor for inclusion in the details of the debtor's payment instruction."
                            ]
                        ]
                        w::p = [
