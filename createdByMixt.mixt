                    ]
                    w::tc = [
                        w::p = [
                            w::r = [
                                w::t = "If an instructed agent asks an instructing agent under rule 9.21 and clause 2.2 of these HVCS Common Procedures, to send data to correct an HVCS instruction, the instructed agent can request the data by, for example, phone or using SWIFT message MTn95-Queries.  If the instructing agent of a payment message sends corrected data to the instructed agent under rule 9.21 and clause 2.2 of these HVCS Common Procedures, the instructing agent can use, for example, SWIFT message MTn96-Answers."
                            ]
                        ]
                    ]
                ]
            ]
            w::p = [
                w::r = [
                    w::t = "SectionHeading: Chapter 3: Late processing"
                ]
            ]
            w::p = [
