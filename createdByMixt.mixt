                            w::r = [
                                w::t = "2.4 Co-operate to resolve processing errors"
                            ]
                        ]
                    ]
                    w::tc = [
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
