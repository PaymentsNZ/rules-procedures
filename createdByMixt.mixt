            w::p = [
                w::r = [
                    w::t = "SectionHeading: Chapter 1: Normal HVCS processing"
                ]
            ]
            w::p = [
                w::r = [
                    w::t = "Standards"
                ]
            ]
            w::tbl = [
                w::tblPr = [
                    w::tblW = null meta {
                        xml::attributes = {
