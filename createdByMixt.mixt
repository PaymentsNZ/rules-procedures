                ]
                w::tr = [
                    w::tc = [
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
                                            w::val = 0
                                        }
                                    }
                                    w::numId = null meta {
                                        xml::attributes = {
                                            w::val = 100
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "1.1 Defined terms"
                            ]
                        ]
                    ]
                    w::tc = [
                        w::p = [
                            w::r = [
                                w::t = "CBPR+"
                            ]
                            w::r = [
                                w::t = " " meta {
                                    xml::attributes = {
                                        xml::space = "preserve"
                                    }
                                }
                            ]
                            w::r = [
                                w::t = "means the ISO 20022-based messaging standard for sending a SWIFT message through the FINplus CUG operated by SWIFT."
                            ]
                        ]
                        w::p = [
                            w::r = [
                                w::t = "pacs.008"
                            ]
                        ]
                        w::p = [
                            w::r = [
                                w::t = "MT192;"
                            ]
                        ]
                        w::p = [
                            w::r = [
                                w::t = "MT196"
                            ]
                        ]
                        w::p = [
                            w::r = [
                                w::t = "MT292;"
                            ]
                        ]
                        w::p = [
                            w::r = [
                                w::t = "MT296"
                            ]
                        ]
                        w::p = [
                            w::r = [
                                w::t = "camt.056; or"
                            ]
                        ]
                        w::p = [
                            w::r = [
                                w::t = "camt.029"
                            ]
                        ]
                        w::p = [
                            w::r = [
                                w::t = "pacs.009; and"
                            ]
                        ]
                        w::p = [
                            w::r = [
                                w::t = "pacs.009COV"
                            ]
                        ]
                        w::p = [
                            w::r = [
                                w::t = "FIN message"
                            ]
                            w::r = [
                                w::t = " " meta {
                                    xml::attributes = {
                                        xml::space = "preserve"
                                    }
                                }
                            ]
                            w::r = [
                                w::t = "means the ISO 15022-based messaging standard for sending a SWIFT message through the general FIN CUG operated by SWIFT."
                            ]
                        ]
                        w::p = [
                            w::r = [
                                w::t = "MT message"
                            ]
                            w::r = [
                                w::t = " " meta {
                                    xml::attributes = {
                                        xml::space = "preserve"
                                    }
                                }
                            ]
                            w::r = [
                                w::t = "means an HVCS instruction sent in accordance with the MT Messaging Procedures"
                            ]
                        ]
                        w::p = [
                            w::r = [
                                w::t = "MX message"
                            ]
                            w::r = [
                                w::t = " " meta {
                                    xml::attributes = {
                                        xml::space = "preserve"
                                    }
                                }
                            ]
                            w::r = [
                                w::t = "means an HVCS instruction sent in accordance with the MX Messaging Procedures and the MX Message Specifications"
                            ]
                        ]
                        w::p = [
                            w::r = [
                                w::t = "MX Message Specifications"
                            ]
                            w::r = [
                                w::t = " " meta {
                                    xml::attributes = {
                                        xml::space = "preserve"
                                    }
                                }
                            ]
                            w::r = [
                                w::t = "means the applicable production version(s) of New Zealand's HVCS Usage Guidelines, being the base ISO 20022 message specifications modified for New Zealand's HVCS and provided on the \"mystandards\" webpage"
                            ]
                        ]
                        w::p = [
                            w::r = [
                                w::t = "pacs.004"
                            ]
                        ]
                        w::p = [
                            w::r = [
                                w::t = "HVCS instruction;"
                            ]
                        ]
                        w::p = [
                            w::r = [
                                w::t = "HVPS message;"
                            ]
                        ]
                        w::p = [
                            w::r = [
                                w::t = "CBPR+; or"
                            ]
                        ]
                        w::p = [
                            w::r = [
                                w::t = "FIN message"
                            ]
                        ]
                        w::p = [
                            w::r = [
                                w::t = "Is it safe to remove:"
                            ]
                        ]
                        w::p = [
                            w::r = [
                                w::t = "- MT010 - Non-Delivery Warning - a message that was being monitored in case of non-delivery, was not delivered before its obsolescence period expired."
                            ]
                        ]
                        w::p = [
                            w::r = [
                                w::t = "- MT011 - Delivery Notification - a message being monitored for delivery has actually been delivered."
                            ]
                        ]
                        w::p = [
                            w::r = [
                                w::t = "- MT019 - Abort Notification -  notifies the sender that the system has been unable to deliver the message specified in the <text-block>, and has been forced to abort it instead."
                            ]
