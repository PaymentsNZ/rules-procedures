                                            w::val = 100
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "A participant that sends HVCS instructions on behalf of a debtor agent pursuant to an agency arrangement must ensure that each debtor agent which it has an agency arrangement with has a SWIFT BIC that can be used by the Participant acting as an instructing agent to identify the debtor agent within the payment message."
                            ]
                        ]
