                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "3.1 Late processing"
                            ]
                        ]
                    ]
                    w::tc = [
                        w::p = [
                            w::r = [
                                w::t = "Rule 9.11 and clause 1.4 of these HVCS Common Procedures requires an instructing agent to send an HVCS instruction no later than 16:45 on a business day unless standards 3.3 or 3.4 apply."
                            ]
                        ]
                        w::p = [
                            w::r = [
                                w::t = "The following diagram gives an overview of the processes that apply if the instructing agent proposes to send an HVCS instruction after 16:45. The diagram has no legal effect."
                            ]
                        ]
                    ]
                ]
            ]
            w::p = [
                w::r = [
                    w::t = "Standards"
                ]
            ]
            w::tbl = [
                w::tblPr = [
                    w::tblW = null meta {
                        xml::attributes = {
                            w::type = "dxa"
                            w::w = 9638
                        }
                    }
                    w::jc = null meta {
                        xml::attributes = {
                            w::val = "left"
                        }
                    }
                    w::tblInd = null meta {
                        xml::attributes = {
                            w::type = "dxa"
                            w::w = "0"
                        }
                    }
                    w::tblLayout = null meta {
                        xml::attributes = {
                            w::type = "fixed"
                        }
                    }
                ]
                w::tblGrid = [
                    w::gridCol = null meta {
                        xml::attributes = {
                            w::w = 1701
                        }
                    }
                    w::gridCol = null meta {
                        xml::attributes = {
                            w::w = 7937
                        }
                    }
                ]
                w::tr = [
                    w::tc = [
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
                                            w::val = 0
                                        }
                                    }
                                    w::numId = null meta {
                                        xml::attributes = {
                                            w::val = 100
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "3.2 When HVCS payments settle"
                            ]
                        ]
                    ]
                    w::tc = [
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
                                            w::val = 1
                                        }
                                    }
                                    w::numId = null meta {
                                        xml::attributes = {
                                            w::val = 100
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "The effect of rule 9.14 is that if the instructing agent settles an HVCS payment after 17:15, unless the late HVCS instruction requirements apply, the instructed agent:"
                            ]
                        ]
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
                                            w::val = 2
                                        }
                                    }
                                    w::numId = null meta {
                                        xml::attributes = {
                                            w::val = 100
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "is not required to process the HVCS instruction that business day, but"
                            ]
                        ]
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
                                            w::val = 2
                                        }
                                    }
                                    w::numId = null meta {
                                        xml::attributes = {
                                            w::val = 100
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "may decide to process the HVCS instruction that business day to meet the requirements or the expectations of its customer."
                            ]
                        ]
                    ]
                ]
            ]
            w::p = [
                w::r = [
                    w::t = "Standards"
                ]
            ]
            w::tbl = [
                w::tblPr = [
                    w::tblW = null meta {
                        xml::attributes = {
                            w::type = "dxa"
                            w::w = 9638
                        }
                    }
