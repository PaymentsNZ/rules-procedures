                    w::t = "Chapter 3: Structured data"
                ]
            ]
            w::tbl = [
                w::tblPr = [
                    w::tblW = null meta {
                        xml::attributes = {
                            w::type = "dxa"
                            w::w = 9638
                        }
                    }
