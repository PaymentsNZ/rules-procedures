                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "This document, the Co-Existence Procedures (Part F) is one part of a suite of documentation to help participants understand what is required to become a high value clearing system (HVCS) participant and how to send and receive individual HVCS instructions and NZD HVCS payments that the participant cannot revoke or reverse after settlement."
                            ]
                        ]
                    ]
                ]
            ]
            w::tbl = [
                w::tblPr = [
                    w::tblW = null meta {
                        xml::attributes = {
                            w::type = "dxa"
                            w::w = 9638
                        }
                    }
                    w::jc = null meta {
                        xml::attributes = {
                            w::val = "left"
                        }
                    }
                    w::tblInd = null meta {
                        xml::attributes = {
                            w::type = "dxa"
                            w::w = "0"
                        }
                    }
                    w::tblLayout = null meta {
                        xml::attributes = {
                            w::type = "fixed"
                        }
                    }
                ]
                w::tblGrid = [
                    w::gridCol = null meta {
                        xml::attributes = {
                            w::w = 1701
                        }
                    }
                    w::gridCol = null meta {
                        xml::attributes = {
                            w::w = 7937
                        }
                    }
                ]
                w::tr = [
                    w::tc = [
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
                                            w::val = 0
                                        }
                                    }
                                    w::numId = null meta {
                                        xml::attributes = {
                                            w::val = 100
                                        }
                                    }
                                ]
                            ]
