                            ]
                            w::r = [
                                w::t = "Domestically, it is recommended that participants review their processes relating to obtaining customer data and acquire any additional customer data needed to ensure all ISO 20022 schema elements needed to provide structured or hybrid name and address information are captured."
                            ]
                        ]
                        w::p = [
