                            ]
                            w::r = [
                                w::t = "means the period determined by Payments NZ in which the MT Messaging Procedures, the MX Messaging Procedures, the MX Message Specifications and these Co-existence Procedures all apply simultaneously beginning on 22 November 2025 and ending on a date:"
                            ]
                        ]
                        w::p = [
                            w::r = [
                                w::t = "in November 2026; or"
                            ]
                        ]
                        w::p = [
                            w::r = [
                                w::t = "as determined by Payments NZ if all participants have fully migrated to using MX messages prior to November 2026."
                            ]
