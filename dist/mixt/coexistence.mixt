                                    xml::attributes = {
                                        xml::space = "preserve"
                                    }
                                }
                            ]
                            w::r = [
                                w::t = "means when a participant, in its capacity as an intermediary:"
                            ]
                        ]
                        w::p = [
                            w::r = [
                                w::t = "receives an MX message from another participant destined for a third party recipient and sends that message as a CBPR+ message to that recipient;"
                            ]
                        ]
                        w::p = [
                            w::r = [
                                w::t = "receives an MT message from another participant destined for a third party recipient and sends that message as a CBPR+ message or a FIN message to that recipient;"
                            ]
                        ]
                        w::p = [
                            w::r = [
                                w::t = "receives a CBPR+ message destined for another participant and sends that message as an MX message to that participant; or"
                            ]
                        ]
                        w::p = [
                            w::r = [
                                w::t = "receives a FIN message destined for another participant and sends that message as an HVCS instruction to that participant."
                            ]
