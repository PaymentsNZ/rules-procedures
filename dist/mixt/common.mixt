                                            w::val = 200
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "Provides binding procedures and product requirements that apply to all HVCS instructions at all times.  This document also contains some non-binding commentary and best practice."
                            ]
                        ]
                        w::p = [
                            w::pPr = [
                                w::numPr = [
