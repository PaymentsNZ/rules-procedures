                                w::t = "2.1 Errors"
                            ]
                        ]
                    ]
                    w::tc = [
                        w::p = [
                            w::r = [
                                w::t = "Sometimes an instructed agent cannot process an HVCS instruction because of, for example, a problem with the content or the format of the instruction or an invalid account number."
                            ]
                        ]
                        w::p = [
                            w::r = [
                                w::t = "If an instructed agent cannot process an HVCS instruction, rule 9.21 and clause 2.2 of these HVCS Common Procedures, provides the instructed agent two options. The instructed agent can either return the HVCS instruction to the instructing agent or the instructed agent can arrange to correct the HVCS instruction."
                            ]
                        ]
                        w::p = [
                            w::r = [
                                w::t = "The following diagram summarises the processes that apply if the HVCS instruction contains an error."
                            ]
                        ]
                    ]
                ]
            ]
            w::tbl = [
                w::tblPr = [
                    w::tblW = null meta {
                        xml::attributes = {
