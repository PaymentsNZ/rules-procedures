                                        }
                                    }
                                    w::numId = null meta {
                                        xml::attributes = {
                                            w::val = 100
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "For example, if an instructed agent credits the amount of a HVCS payment to the wrong creditor's account number—"
                            ]
                        ]
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
                                            w::val = 2
                                        }
                                    }
                                    w::numId = null meta {
                                        xml::attributes = {
                                            w::val = 100
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "the instructing agent may ask the instructed agent to freeze funds in the creditor's account until the problem is resolved; and"
                            ]
                        ]
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
                                            w::val = 2
                                        }
                                    }
                                    w::numId = null meta {
                                        xml::attributes = {
                                            w::val = 100
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "the instructed agent should determine whether to comply with the request, including by having regard to whether the instructed agent has the legal right to do so."
                            ]
                        ]
                    ]
