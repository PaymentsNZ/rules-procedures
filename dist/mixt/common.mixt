                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "Participants should co-operate to resolve a problem caused by a processing error affecting a HVCS instruction."
                            ]
                        ]
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
