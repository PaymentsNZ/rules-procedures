                        ]
                    ]
                    w::tc = [
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
                                            w::val = 1
                                        }
                                    }
                                    w::numId = null meta {
                                        xml::attributes = {
                                            w::val = 100
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "This clause applies to an instructed agent who has received a settled HVCS payment but cannot process the HVCS payment because of an error relating to the HVCS payment."
                            ]
                        ]
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
                                            w::val = 1
                                        }
                                    }
                                    w::numId = null meta {
                                        xml::attributes = {
                                            w::val = 100
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "The instructed agent must do one of the following:"
                            ]
                        ]
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
                                            w::val = 2
                                        }
                                    }
                                    w::numId = null meta {
                                        xml::attributes = {
                                            w::val = 100
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "return the HVCS payment to the instructing agent in accordance with the applicable HVCS standards:"
                            ]
                        ]
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
                                            w::val = 2
                                        }
                                    }
                                    w::numId = null meta {
                                        xml::attributes = {
                                            w::val = 100
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "require the instructing agent to send data to amend the HVCS payment:"
                            ]
                        ]
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
                                            w::val = 2
                                        }
                                    }
                                    w::numId = null meta {
                                        xml::attributes = {
                                            w::val = 100
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "amend the HVCS payment without asking the instructing agent for amended data and, as soon as practicable after amendment is complete, process the HVCS payment."
                            ]
                        ]
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
                                            w::val = 1
                                        }
                                    }
                                    w::numId = null meta {
                                        xml::attributes = {
                                            w::val = 100
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "For a cross border redirection (as described in clause 9.1(2)(a)(iii) of the Rules), the instructed agent must not deduct any fees from the amount of the HVCS payment before returning it."
                            ]
                        ]
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
                                            w::val = 1
                                        }
                                    }
                                    w::numId = null meta {
                                        xml::attributes = {
                                            w::val = 100
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "If an instructing agent of an HVCS payment receives a request from an instructed agent under subclause (2)(b), the instructing agent must, as soon as practicable after receiving the request, send data to amend the HVCS payment to the instructed agent."
                            ]
                        ]
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
                                            w::val = 1
                                        }
                                    }
                                    w::numId = null meta {
                                        xml::attributes = {
                                            w::val = 100
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "If the instructed agent receives amended data from an instructing agent under subclause (4), the instructing agent must, as soon as practicable after receiving the data, use the data to amend the HVCS payment."
                            ]
                        ]
                    ]
                ]
            ]
