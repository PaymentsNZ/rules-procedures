                                        }
                                    }
                                    w::numId = null meta {
                                        xml::attributes = {
                                            w::val = 200
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "Provides binding procedures for participants during the co-existence phase of the migration from sending and receiving MT messages to MX messages."
                            ]
                        ]
