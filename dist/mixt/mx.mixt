                            w::r = [
                                w::t = "This document discusses the MX Messaging Procedures that apply to HVCS instructions. It is recommended if you're not familiar with the ISO 20022 message format to read ISO for Dummies."
                            ]
                        ]
                        w::p = [
                            w::pPr = [
