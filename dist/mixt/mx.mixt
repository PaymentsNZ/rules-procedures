                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "Chapter 3 introduces key concepts of ISO 20022 including the message structure, agents in a payment, identifying message types and usage guidelines, external code lists, BICs, Distinguished Names, remittance information, structured data, character sets, and payment identifiers."
