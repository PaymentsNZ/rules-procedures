                            w::r = [
                                w::rPr = [
                                    w::b = null
                                ]
                                w::t = "5.1 How to represent direct and cover payments"
                            ]
                        ]
                    ]
                    w::tc = [
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
                                            w::val = 1
                                        }
                                    }
                                    w::numId = null meta {
                                        xml::attributes = {
                                            w::val = 100
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "During the migration from MT to MX messaging, several scenarios were identified where domestic direct and cover messages were used to send payments to beneficiary accounts to ensure they were not identified as SCPs, and hence did not trigger SCP obligations such as account number formatting or timing."
                            ]
                        ]
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
                                            w::val = 1
                                        }
                                    }
                                    w::numId = null meta {
                                        xml::attributes = {
                                            w::val = 100
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "This section discusses how these payments should be represented in an MX message."
                            ]
                        ]
                        w::tbl = [
                            w::tblPr = [
                                w::tblW = null meta {
                                    xml::attributes = {
                                        w::type = "pct"
                                        w::w = 5000
                                    }
                                }
                                w::jc = null meta {
                                    xml::attributes = {
                                        w::val = "left"
                                    }
                                }
                                w::tblBorders = [
                                    w::top = null meta {
                                        xml::attributes = {
                                            w::val = "single"
                                            w::sz = 4
                                            w::color = "000000"
                                        }
                                    }
                                    w::left = null meta {
                                        xml::attributes = {
                                            w::val = "single"
                                            w::sz = 4
                                            w::color = "000000"
                                        }
                                    }
                                    w::bottom = null meta {
                                        xml::attributes = {
                                            w::val = "single"
                                            w::sz = 4
                                            w::color = "000000"
                                        }
                                    }
                                    w::right = null meta {
                                        xml::attributes = {
                                            w::val = "single"
                                            w::sz = 4
                                            w::color = "000000"
                                        }
                                    }
                                    w::insideH = null meta {
                                        xml::attributes = {
                                            w::val = "single"
                                            w::sz = 4
                                            w::color = "000000"
                                        }
                                    }
                                    w::insideV = null meta {
                                        xml::attributes = {
                                            w::val = "single"
                                            w::sz = 4
                                            w::color = "000000"
                                        }
                                    }
                                ]
                            ]
                            w::tblGrid = [
                                w::gridCol = null meta {
                                    xml::attributes = {
                                        w::w = 1000
                                    }
                                }
                                w::gridCol = null meta {
                                    xml::attributes = {
                                        w::w = 1000
                                    }
                                }
                            ]
                            w::tr = [
                                w::tc = [
                                    w::p = [
                                        w::r = [
                                            w::rPr = [
                                                w::b = null
                                            ]
                                            w::t = "Scenario"
                                        ]
                                    ]
                                ]
                                w::tc = [
                                    w::p = [
                                        w::r = [
                                            w::rPr = [
                                                w::b = null
                                            ]
                                            w::t = "Recommendation"
                                        ]
                                    ]
                                ]
                            ]
                            w::tr = [
                                w::tc = [
                                    w::p = [
                                        w::r = [
                                            w::t = "1. Late payments made after 16:45 cut-off"
                                        ]
                                    ]
                                ]
                                w::tc = []
                            ]
                            w::tr = [
                                w::tc = [
                                    w::p = [
                                        w::r = [
                                            w::t = "2. Avoid account number formatting restrictions (e.g. NZD payment to a foreign currency account of a domestic creditor)"
                                        ]
                                    ]
                                ]
                                w::tc = [
                                    w::p = [
                                        w::r = [
                                            w::t = ""
                                        ]
                                    ]
                                ]
                            ]
                            w::tr = [
                                w::tc = [
                                    w::p = [
                                        w::r = [
                                            w::t = "3. Send NZD to a domestic FI who is neither a participant nor AVP MX CUG member"
                                        ]
                                    ]
                                ]
                                w::tc = [
                                    w::p = [
                                        w::r = [
                                            w::t = "If an RMA and D&C agreement is in place, send as direct and cover payment using CBPR+ for the direct leg and HVCS for the cover leg."
                                        ]
                                    ]
                                    w::p = [
                                        w::r = [
                                            w::t = "If an RMA or D&C agreement is not in place, send as serial HVCS pacs.008 payment message and omit the Local Instrument code thus specifying that the HVCS payment should not be treated as a SCP."
                                        ]
                                    ]
                                ]
                            ]
                            w::tr = [
                                w::tc = [
                                    w::p = [
                                        w::r = [
                                            w::t = "4. Send NZD to a foreign FI holding a Vostro account with another participant"
                                        ]
                                    ]
                                ]
                                w::tc = [
                                    w::p = [
                                        w::r = [
                                            w::t = ""
                                        ]
                                    ]
                                ]
                            ]
                        ]
                        w::p = null
                    ]
                ]
            ]
            w::p = [
                w::pPr = [
                    w::pStyle = null meta {
                        xml::attributes = {
                            w::val = "Heading1"
                        }
                    }
                ]
                w::r = [
                    w::t = "Chapter 6: Payment returns"
                ]
            ]
            w::tbl = [
                w::tblPr = [
                    w::tblW = null meta {
                        xml::attributes = {
                            w::type = "dxa"
                            w::w = 9638
                        }
                    }
                    w::jc = null meta {
                        xml::attributes = {
                            w::val = "left"
                        }
                    }
                    w::tblInd = null meta {
                        xml::attributes = {
                            w::type = "dxa"
                            w::w = "0"
                        }
                    }
                    w::tblLayout = null meta {
                        xml::attributes = {
                            w::type = "fixed"
                        }
                    }
                ]
                w::tblGrid = [
                    w::gridCol = null meta {
                        xml::attributes = {
                            w::w = 1701
                        }
                    }
                    w::gridCol = null meta {
                        xml::attributes = {
                            w::w = 7937
                        }
                    }
                ]
                w::tr = [
                    w::tc = [
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
                                            w::val = 0
                                        }
                                    }
                                    w::numId = null meta {
                                        xml::attributes = {
                                            w::val = 100
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::rPr = [
                                    w::b = null
                                ]
                                w::t = "6.1 Overview"
                            ]
                        ]
                    ]
                    w::tc = [
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
                                            w::val = 1
                                        }
                                    }
                                    w::numId = null meta {
                                        xml::attributes = {
                                            w::val = 100
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "The pacs.004 return message is sent by an agent to the previous agent in the payment chain to return a payment previously settled."
                            ]
                        ]
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
                                            w::val = 1
                                        }
                                    }
                                    w::numId = null meta {
                                        xml::attributes = {
                                            w::val = 100
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "Payment returns may be the consequence of a payment cancellation requested by the instructing agent of the original payment message (solicited) or initiated by the original instructed agent as an unsolicited payment return."
                            ]
                        ]
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
                                            w::val = 1
                                        }
                                    }
                                    w::numId = null meta {
                                        xml::attributes = {
                                            w::val = 100
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "The pacs.004 return message structure is equivalent to the MT 103/103+ (customer credit transfer message) REJT/RETN and the MT202/202 COV (financial institution credit transfer message) REJT/RETN. A REJT/ RETN message is functionally like an unsolicited / solicited pacs.004, respectively."
                            ]
                        ]
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
                                            w::val = 1
                                        }
                                    }
                                    w::numId = null meta {
                                        xml::attributes = {
                                            w::val = 100
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "When using the pacs.004 return message, it is important to note the following:"
                            ]
                        ]
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
                                            w::val = 2
                                        }
                                    }
                                    w::numId = null meta {
                                        xml::attributes = {
                                            w::val = 100
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "Each pacs.004 return message must contain one HVCS return payment."
                            ]
                        ]
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
                                            w::val = 2
                                        }
                                    }
                                    w::numId = null meta {
                                        xml::attributes = {
                                            w::val = 100
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "HVCS supports partial solicited payment returns with the use of multiple pacs.004 return messages to return an HVCS payment in instalments."
                            ]
                        ]
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
                                            w::val = 2
                                        }
                                    }
                                    w::numId = null meta {
                                        xml::attributes = {
                                            w::val = 100
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "Unsolicited payment returns should be returned in a single return payment instruction."
                            ]
                        ]
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
                                            w::val = 2
                                        }
                                    }
                                    w::numId = null meta {
                                        xml::attributes = {
                                            w::val = 100
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "The returned Interbank Settlement Amount could be different from the original Interbank Settlement Amount for cross border payments due to currency exchange or charge fees. Participants must be able to receive a returned Interbank Settlement Amount that is different from the original Interbank Settlement Amount. The instructed agent that sends the pacs.004 return message cannot deduct a fee from the amount of an HVCS payment before returning it."
                            ]
                        ]
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
                                            w::val = 2
                                        }
                                    }
                                    w::numId = null meta {
                                        xml::attributes = {
                                            w::val = 100
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "The pacs.004 return message must be used to return an HVCS payment regardless of whether the return chain is the same as the original forward path or if it follows a different path."
                            ]
                        ]
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
                                            w::val = 2
                                        }
                                    }
                                    w::numId = null meta {
                                        xml::attributes = {
                                            w::val = 100
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "Participants cannot use the pacs.004 return message to return a return HVCS payment. If returning an HVCS payment received in a pacs.004 return message, the original payment type, as referenced in the pacs.004 return message, should be used."
                            ]
                        ]
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
                                            w::val = 2
                                        }
                                    }
                                    w::numId = null meta {
                                        xml::attributes = {
                                            w::val = 100
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "The pacs.004 return message does not cater for the Instruction for Next Agent element, so it is not possible to apply the ESAS conditional release options to a pacs.004 return message."
                            ]
                        ]
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
                                            w::val = 2
                                        }
                                    }
                                    w::numId = null meta {
                                        xml::attributes = {
                                            w::val = 100
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "Original parties of the underlying pacs.008, pacs.009, pacs.009 COV payment are reversed in the pacs.004 return message relative to the original payment. ie. the debtor of original payment becomes the creditor in the pacs.004 return message and the creditor of the original payment becomes the debtor in the pacs.004 return message."
                            ]
                        ]
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
                                            w::val = 2
                                        }
                                    }
                                    w::numId = null meta {
                                        xml::attributes = {
                                            w::val = 100
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "A participant acting as an Intermediary agent, and on-return cross border payment may find new ISO 20022 return reason codes, which are not parts of HVCS reason codes."
                            ]
                        ]
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
                                            w::val = 1
                                        }
                                    }
                                    w::numId = null meta {
                                        xml::attributes = {
                                            w::val = 100
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "The pacs.004 return message is passed from one participant to another participant serially, as shown in the diagram below."
                            ]
                        ]
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
                                            w::val = 1
                                        }
                                    }
                                    w::numId = null meta {
                                        xml::attributes = {
                                            w::val = 100
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "The pacs.004 return message uses a number of elements to capture details from the underlying payment it is returning, which are nested within the Original Group Information and Transaction Information elements. The pacs.004 return message relates to the original payment instruction through references / identifiers in conjunction with attributes from the original payment instruction. A number of these elements are mandatory within the HVCS to ensure the pacs.004 return message conveys sufficient details to the instructed agent."
                            ]
                        ]
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
                                            w::val = 1
                                        }
                                    }
                                    w::numId = null meta {
                                        xml::attributes = {
                                            w::val = 100
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "When returning a payment by the cover method, the pacs.004 return message follows the path of the pacs.009 COV payment message as shown below:"
                            ]
                        ]
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
                                            w::val = 1
                                        }
                                    }
                                    w::numId = null meta {
                                        xml::attributes = {
                                            w::val = 100
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "Again, the pacs.004 return message is sent serially between banks, this time referencing the pacs.009 COV payment message within the Original Group Information and Transaction Information elements of the pacs.004 return message. The information of the underlying pacs.008 payment message for which cover is provided must be captured in the Underlying Customer Credit Transfer elements."
                            ]
                        ]
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
                                            w::val = 1
                                        }
                                    }
                                    w::numId = null meta {
                                        xml::attributes = {
                                            w::val = 100
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "When acting as intermediary, upon receipt of a pacs.004 return message, that requires on-sending, the same path is to be taken regardless of whether the return originated domestically or cross-border."
                            ]
                        ]
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
                                            w::val = 1
                                        }
                                    }
                                    w::numId = null meta {
                                        xml::attributes = {
                                            w::val = 100
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "In some scenarios, for example if the intermediary bank was not involved in the original forward path, the intermediary may not have access to the original message details and must seek them in order to correctly populate the domestic pacs.004 return message."
                            ]
                        ]
                    ]
                ]
            ]
            w::p = [
                w::pPr = [
                    w::pStyle = null meta {
                        xml::attributes = {
                            w::val = "Heading1"
                        }
                    }
                ]
                w::r = [
                    w::t = "Chapter 7: Exception and Investigation messages"
                ]
            ]
            w::tbl = [
                w::tblPr = [
                    w::tblW = null meta {
                        xml::attributes = {
                            w::type = "dxa"
                            w::w = 9638
                        }
                    }
                    w::jc = null meta {
                        xml::attributes = {
                            w::val = "left"
                        }
                    }
                    w::tblInd = null meta {
                        xml::attributes = {
                            w::type = "dxa"
                            w::w = "0"
                        }
                    }
                    w::tblLayout = null meta {
                        xml::attributes = {
                            w::type = "fixed"
                        }
                    }
                ]
                w::tblGrid = [
                    w::gridCol = null meta {
                        xml::attributes = {
                            w::w = 1701
                        }
                    }
                    w::gridCol = null meta {
                        xml::attributes = {
                            w::w = 7937
                        }
                    }
                ]
                w::tr = [
                    w::tc = [
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
                                            w::val = 0
                                        }
                                    }
                                    w::numId = null meta {
                                        xml::attributes = {
                                            w::val = 100
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::rPr = [
                                    w::b = null
                                ]
                                w::t = "7.1 Overview"
                            ]
                        ]
                    ]
                    w::tc = [
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
                                            w::val = 1
                                        }
                                    }
                                    w::numId = null meta {
                                        xml::attributes = {
                                            w::val = 100
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "Exception and investigation messages are designed to support case management functions related to payment instructions."
                            ]
                        ]
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
                                            w::val = 1
                                        }
                                    }
                                    w::numId = null meta {
                                        xml::attributes = {
                                            w::val = 100
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "The camt.056 (FI to FI Payment Cancellation Request) message is used to request the return of an HVCS payment, for example, in the case of a mistaken payment (debtor error)."
                            ]
                        ]
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
                                            w::val = 1
                                        }
                                    }
                                    w::numId = null meta {
                                        xml::attributes = {
                                            w::val = 100
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "The camt.056 message must be used only to request the return of HVCS payments and the instructing agent of the original HVCS payment must include their investigation case identifier within the “Case/Identification” element within the camt.056 message."
                            ]
                        ]
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
                                            w::val = 1
                                        }
                                    }
                                    w::numId = null meta {
                                        xml::attributes = {
                                            w::val = 100
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "The camt.029 (Resolution of Investigation) message is used to either accept, reject, or provide a pending status for a camt.056 message."
                            ]
                        ]
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
                                            w::val = 1
                                        }
                                    }
                                    w::numId = null meta {
                                        xml::attributes = {
                                            w::val = 100
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "Exception and investigation messages must be sent within the AVP MX CUG."
                            ]
                        ]
                    ]
                ]
            ]
            w::tbl = [
                w::tblPr = [
                    w::tblW = null meta {
                        xml::attributes = {
                            w::type = "dxa"
