                                        xml::attributes = {
                                            w::val = 100
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "Intermediaries will be able to receive their choice of API, MX or MX with embedded MT for different back office system applications or purposes. If the embedded MT format is chosen, some loss of data may occur in the MT message itself, but full message details can be accessed via the Transaction Manager or in the MX portion of the message."
                            ]
                        ]
