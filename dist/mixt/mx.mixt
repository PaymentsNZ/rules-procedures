                                    }
                                    w::numId = null meta {
                                        xml::attributes = {
                                            w::val = 100
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "This is an optional element within the HVCS, however, if used, the LEI must be used in combination with Account number or BIC or Name and Address to keep usage consistent with CBPR+."
                            ]
                        ]
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
                                            w::val = 1
                                        }
                                    }
                                    w::numId = null meta {
                                        xml::attributes = {
                                            w::val = 100
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "The Payments Market Practice Group (PMPG) have provided extensive guidance in their paper"
                            ]
                            w::r = [
                                w::t = " " meta {
                                    xml::attributes = {
                                        xml::space = "preserve"
                                    }
                                }
                            ]
                            w::r = [
                                w::t = "Global adoption of the LEI (Legal Entity Identifier) in ISO 20022 payment messages."
                            ]
                        ]
                    ]
