                                w::t = ". These code lists are maintained by SWIFT (through their quarterly release cycle) and are published for use here. Unless  otherwise stated in the MX Message Specifications, the HVCS does not restrict use of any of these codes."
                            ]
                        ]
                    ]
                ]
