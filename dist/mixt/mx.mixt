                            w::r = [
                                w::t = "This section provides guidance for how the schema should be used to transport New Zealand addresses containing debtor and creditor address information for all HVCS payments, including exclusively  domestic payments and the domestic element of cross border payments. The guidance below is to be followed when structured address line formatting is used."
                            ]
                        ]
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
                                            w::val = 1
                                        }
                                    }
                                    w::numId = null meta {
                                        xml::attributes = {
                                            w::val = 100
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "The guidance will be used by financial institutions both in New Zealand and overseas for the transmission of a New Zealand address within any ISO 20022 Usage Guideline. This aspect is important, because the address may be first placed into an ISO 20022 format in an overseas market infrastructure before transitioning to CBPR+ and then to NZ HVCS as part of its journey through the chain of agencies."
                            ]
                        ]
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
                                            w::val = 1
                                        }
                                    }
                                    w::numId = null meta {
                                        xml::attributes = {
                                            w::val = 100
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "The Payments Market Practice Group (PMPG) publish the structured address format guidance for each country to SWIFT's Document Centre. See"
                            ]
                            w::r = [
                                w::t = " " meta {
                                    xml::attributes = {
                                        xml::space = "preserve"
                                    }
                                }
                            ]
                            w::r = [
                                w::t = "ISO 20022 Structure Postal Address"
                            ]
                            w::r = [
                                w::t = " " meta {
                                    xml::attributes = {
                                        xml::space = "preserve"
                                    }
                                }
                            ]
                            w::r = [
                                w::t = " to download this. Note the content of the document is not validated anywhere on the SWIFT network."
                            ]
                        ]
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
                                            w::val = 1
