                                    w::b = null
                                ]
                                w::t = "Usage Guidelines"
                            ]
                            w::r = [
                                w::t = " " meta {
                                    xml::attributes = {
                                        xml::space = "preserve"
                                    }
                                }
                            ]
                            w::r = [
                                w::t = "are a combination of the ISO 20022 base standard message definition plus restrictions that adapted the specifications to meet local market practice.  The Usage Guideline can also include additional commentary to explain how local instructions should be constructed for specific scenarios.  In the New Zealand context, the Usage Guidelines that apply to HVCS are contained in the MX Message Specifications."
                            ]
