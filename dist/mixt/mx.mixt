                                    }
                                }
                            ]
                            w::r = [
                                w::t = "Define cross-element rules"
                            ]
                        ]
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
                                            w::val = 1
                                        }
                                    }
                                    w::numId = null meta {
                                        xml::attributes = {
                                            w::val = 100
                                        }
                                    }
