                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "The Legal Entity Identifier (LEI) is a 20-character, alpha-numeric code, designed to uniquely identify legally distinct entities that engage in financial transactions. It requires annual verification, carries useful information about company structure, and is the globally recognized ISO 17442 standard."
                            ]
                        ]
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
                                            w::val = 1
