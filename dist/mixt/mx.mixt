                            w::r = [
                                w::t = " " meta {
                                    xml::attributes = {
                                        xml::space = "preserve"
                                    }
                                }
                            ]
                            w::r = [
                                w::t = "are constraints applied to the ISO 20022 base standard and must be applied such that they do not contradict that standard.  Restrictions are defined by participants of New Zealand's HVCS in conjunction with Payments NZ and can:"
                            ]
                            w::r = [
                                w::t = " " meta {
                                    xml::attributes = {
                                        xml::space = "preserve"
                                    }
                                }
                            ]
                            w::r = [
                                w::t = "Prevent use of a non-mandatory element"
                            ]
                            w::r = [
                                w::t = " " meta {
                                    xml::attributes = {
                                        xml::space = "preserve"
                                    }
                                }
                            ]
                            w::r = [
                                w::t = "Make a non-mandatory element mandatory"
                            ]
                            w::r = [
                                w::t = " " meta {
                                    xml::attributes = {
                                        xml::space = "preserve"
                                    }
                                }
                            ]
                            w::r = [
                                w::t = "Restrict the number of occurrences of an element"
