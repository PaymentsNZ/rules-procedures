                                            w::val = 100
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "The platform will ensure interoperability between users of different data formats and connectivity channels, but those that want to unlock the full benefits of richer data and advanced platform features will need to implement ISO 20022 and APIs."
                            ]
                        ]
                        w::p = [
                            w::pPr = [
