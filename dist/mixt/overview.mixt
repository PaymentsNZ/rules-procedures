                    w::tc = [
                        w::p = [
                            w::r = [
                                w::t = "The Payments NZ rules and procedures are the principal rules regulating HVCS clearing and settlement in New Zealand. They are a multilateral contract that bind agents who are a direct settlement participants acting in various capacities including:"
                            ]
                        ]
                        w::p = [
                            w::pPr = [
