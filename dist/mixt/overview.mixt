                                        xml::attributes = {
                                            w::val = 200
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "the identification, verification, or sanctions compliance requirements for wire transfers in the:"
                            ]
                        ]
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
                                            w::val = 1
                                        }
