                                    w::numId = null meta {
                                        xml::attributes = {
                                            w::val = 200
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "NZ Anti-Money Laundering and Countering Financing of Terrorism Act 2009;"
                            ]
                        ]
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
                                            w::val = 1
                                        }
                                    }
                                    w::numId = null meta {
                                        xml::attributes = {
