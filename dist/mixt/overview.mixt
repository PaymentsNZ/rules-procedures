                            w::r = [
                                w::rPr = [
                                    w::b = null
                                ]
                                w::t = "1.1 Rationale for Change"
                            ]
                        ]
                    ]
                    w::tc = [
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
                                            w::val = 1
                                        }
                                    }
                                    w::numId = null meta {
                                        xml::attributes = {
                                            w::val = 100
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "The Appendix 14 procedures received significant revision during 2022 to support the introduction of MX messaging for the High Value Clearing System (HVCS) and the coexistence period for MT and MX messaging from 2023 through 2025."
                            ]
                        ]
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
                                            w::val = 1
                                        }
                                    }
                                    w::numId = null meta {
                                        xml::attributes = {
                                            w::val = 100
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "The introduction of MX messages to the High Value Clearing System (HVCS) introduced new ISO standard terms.  Readers familiar with the previous Appendix 14 will note that many of the terms used previously by the NZ payments industry have been replaced with their ISO equivalents in both the HVCS rules and procedures."
                            ]
                        ]
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
                                            w::val = 1
                                        }
                                    }
                                    w::numId = null meta {
                                        xml::attributes = {
                                            w::val = 100
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "There are also many places where MT specific terms have been replaced by message system agnostic terms.  This was necessary to prepare for the removal of MT payment messaging from November 2025."
                            ]
                        ]
                    ]
                ]
            ]
