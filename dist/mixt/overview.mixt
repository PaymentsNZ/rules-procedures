                            w::r = [
                                w::t = " " meta {
                                    xml::attributes = {
                                        xml::space = "preserve"
                                    }
                                }
                            ]
                            w::r = [
                                w::t = "fast; and"
                            ]
                            w::r = [
                                w::t = " " meta {
                                    xml::attributes = {
                                        xml::space = "preserve"
                                    }
                                }
                            ]
                            w::r = [
                                w::t = "irrevocable"
                            ]
                            w::r = [
                                w::t = " " meta {
                                    xml::attributes = {
                                        xml::space = "preserve"
                                    }
                                }
                            ]
                            w::r = [
                                w::t = "Therefore:"
                            ]
                            w::r = [
                                w::t = " " meta {
                                    xml::attributes = {
                                        xml::space = "preserve"
                                    }
                                }
                            ]
                            w::r = [
                                w::t = "an HVCS payment cannot be reversed by the instructing agent after settlement, and"
                            ]
                            w::r = [
                                w::t = " " meta {
                                    xml::attributes = {
                                        xml::space = "preserve"
                                    }
                                }
                            ]
                            w::r = [
                                w::t = "if the creditor's account is credited with the amount of the HVCS payment, the instructed agent cannot reverse the HVCS payment."
