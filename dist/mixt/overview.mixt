                    w::tc = [
                        w::p = [
                            w::r = [
                                w::t = "No legislation directly regulates HVCS clearing and settlement in New Zealand. Some legislation indirectly affects HVCS clearing and settlement, for example:"
                            ]
                        ]
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
                                            w::val = 0
