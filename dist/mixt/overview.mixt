                w::tr = [
                    w::tc = [
                        w::p = [
                            w::r = [
                                w::t = "ESAS"
                            ]
                        ]
                    ]
                    w::tc = [
                        w::p = [
                            w::r = [
                                w::t = "Is the system that holds the settlement accounts of financial institutions and enables the instructing agent to send a payment instruction to settle the HVCS payment by transferring the value from the instructing agent's settlement account to the instructed agent's settlement account."
                            ]
                        ]
                        w::p = [
                            w::r = [
                                w::t = "ESAS is owned, operated, and managed by the Reserve Bank."
                            ]
                        ]
                    ]
                ]
                w::tr = [
                    w::tc = [
                        w::p = [
                            w::r = [
                                w::t = "SWIFT FIN"
                            ]
                        ]
                    ]
                    w::tc = [
                        w::p = [
                            w::r = [
                                w::t = "Is a messaging service that enables financial institutions to exchange SWIFT messages in MT format in store-and-forward mode. For more information see appendix 14E: MT Messaging Procedures."
                            ]
