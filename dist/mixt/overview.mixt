                    w::tblLayout = null meta {
                        xml::attributes = {
                            w::type = "fixed"
                        }
                    }
                ]
                w::tblGrid = [
                    w::gridCol = null meta {
                        xml::attributes = {
                            w::w = 1701
                        }
                    }
                    w::gridCol = null meta {
                        xml::attributes = {
                            w::w = 7937
                        }
                    }
                ]
                w::tr = [
                    w::tc = [
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
                                            w::val = 0
                                        }
                                    }
                                    w::numId = null meta {
                                        xml::attributes = {
                                            w::val = 100
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::rPr = [
                                    w::b = null
                                ]
                                w::t = "Standards, best practices and commentary"
                            ]
                        ]
                    ]
                    w::tc = [
                        w::p = [
                            w::r = [
                                w::t = "This section specifies how participants can determine whether the content of an applicable HVCS Standard in appendix 14 creates binding legal rights or obligations."
                            ]
                        ]
                        w::p = [
                            w::r = [
                                w::t = "Rule 1.8 provides:"
                            ]
                        ]
                    ]
                ]
            ]
            w::tbl = [
                w::tblPr = [
                    w::tblW = null meta {
                        xml::attributes = {
                            w::type = "dxa"
                            w::w = 9638
                        }
                    }
                    w::jc = null meta {
                        xml::attributes = {
                            w::val = "left"
                        }
                    }
                    w::tblInd = null meta {
                        xml::attributes = {
                            w::type = "dxa"
                            w::w = "0"
                        }
                    }
                    w::tblLayout = null meta {
                        xml::attributes = {
                            w::type = "fixed"
                        }
                    }
                ]
                w::tblGrid = [
                    w::gridCol = null meta {
                        xml::attributes = {
                            w::w = 1701
                        }
                    }
                    w::gridCol = null meta {
                        xml::attributes = {
                            w::w = 7937
                        }
                    }
                ]
                w::tr = [
                    w::tc = [
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
                                            w::val = 0
                                        }
                                    }
                                    w::numId = null meta {
                                        xml::attributes = {
                                            w::val = 100
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::rPr = [
                                    w::b = null
                                ]
                                w::t = "Rules bind participants and affect customers"
                            ]
                        ]
                    ]
                    w::tc = [
                        w::p = [
                            w::r = [
                                w::t = "The HVCS rules and procedures are a multilateral contract that binds Payments NZ and direct settlement participants acting in various capacities including:"
                            ]
                        ]
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
                                            w::val = 0
                                        }
                                    }
                                    w::numId = null meta {
                                        xml::attributes = {
                                            w::val = 200
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "instructing agents;"
                            ]
                        ]
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
                                            w::val = 0
                                        }
                                    }
                                    w::numId = null meta {
                                        xml::attributes = {
                                            w::val = 200
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "instructed agents;"
                            ]
                        ]
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
                                            w::val = 0
                                        }
                                    }
                                    w::numId = null meta {
                                        xml::attributes = {
                                            w::val = 200
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "sender of an exception and investigation message or SWIFT messages;"
                            ]
                        ]
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
                                            w::val = 0
                                        }
                                    }
                                    w::numId = null meta {
                                        xml::attributes = {
                                            w::val = 200
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "receiver of an exception and investigation message, system message or SWIFT messages;"
                            ]
                        ]
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
                                            w::val = 0
                                        }
                                    }
                                    w::numId = null meta {
                                        xml::attributes = {
                                            w::val = 200
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "creditor agents; and/or"
                            ]
                        ]
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
                                            w::val = 0
                                        }
                                    }
                                    w::numId = null meta {
                                        xml::attributes = {
                                            w::val = 200
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "debtor agents."
                            ]
                        ]
                        w::p = [
                            w::r = [
                                w::t = "NOTE: It is important to understand that the terms 'instructing agent' and 'instructed agent' are also defined terms under the ISO 20022 standard.  This means that the ISO 20022 standard might describe a person as an 'instructing agent' or an 'instructed agent' even if they are not a HVCS participant.  However, the Rules have narrowed these definitions from their meaning under the ISO 20022 standard.  This means that whenever these terms are used in the Rules and the HVCS Standards, it is referring to HVCS participants only that fulfil the role of an instructing agent or an instructed agent."
                            ]
                        ]
                        w::p = [
                            w::r = [
                                w::t = "The multilateral contract does not bind other third parties involved in the HVCS clearing process like debtors, who are customers of debtor agents (often acting as the instructing agent), or creditors, who are customers of creditor agents (often acting as the instructed agent)."
                            ]
                        ]
                        w::p = [
                            w::r = [
                                w::t = "If the HVCS rules and the procedures give a participant a right:"
                            ]
                        ]
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
                                            w::val = 0
                                        }
                                    }
                                    w::numId = null meta {
                                        xml::attributes = {
                                            w::val = 200
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "no corresponding obligation is imposed on any other person or entity who is not a participant, and"
                            ]
                        ]
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
                                            w::val = 0
                                        }
                                    }
                                    w::numId = null meta {
                                        xml::attributes = {
                                            w::val = 200
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "other participants must recognise the right when they deal with the participant."
                            ]
                        ]
                        w::p = [
                            w::r = [
                                w::t = "Although the rules and procedures can't bind debtors or creditors, rule 9.8 requires participants to ensure that the terms and conditions of each agreement between the participant and an HVCS debtor or creditor are consistent with the HVCS rules. Payments NZ recommends standard terms and conditions that relate to 1 type of HVCS payment — an SCP — that participants can include in their terms and conditions with SCP customers in chapter 2 of the SCP Procedures."
                            ]
                        ]
                    ]
                ]
            ]
            w::tbl = [
                w::tblPr = [
                    w::tblW = null meta {
                        xml::attributes = {
                            w::type = "dxa"
                            w::w = 9638
                        }
                    }
                    w::jc = null meta {
                        xml::attributes = {
                            w::val = "left"
                        }
                    }
                    w::tblInd = null meta {
                        xml::attributes = {
                            w::type = "dxa"
                            w::w = "0"
                        }
                    }
                    w::tblLayout = null meta {
                        xml::attributes = {
                            w::type = "fixed"
                        }
                    }
                ]
                w::tblGrid = [
                    w::gridCol = null meta {
                        xml::attributes = {
                            w::w = 1701
                        }
                    }
                    w::gridCol = null meta {
                        xml::attributes = {
                            w::w = 7937
                        }
                    }
                ]
                w::tr = [
                    w::tc = [
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
                                            w::val = 0
                                        }
                                    }
                                    w::numId = null meta {
                                        xml::attributes = {
                                            w::val = 100
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::rPr = [
                                    w::b = null
                                ]
                                w::t = "Document purpose and structure"
                            ]
                        ]
                    ]
                    w::tc = [
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
                                            w::val = 1
                                        }
                                    }
                                    w::numId = null meta {
                                        xml::attributes = {
                                            w::val = 100
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "This document provides participants with a general introduction to the HVCS and gives context to the other documents that make up the applicable HVCS Standards (Appendix 14). It introduces the types of messages used by the HVCS, the concept of Y-copy, frequently used terminology, and the organisations and systems involved in the clearing and settlement process and provides participants with a high level overview of the payment message flows used by the HVCS."
                            ]
                        ]
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
                                            w::val = 1
                                        }
                                    }
                                    w::numId = null meta {
                                        xml::attributes = {
                                            w::val = 100
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "This document is divided into six chapters."
                            ]
                        ]
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
                                            w::val = 1
                                        }
                                    }
                                    w::numId = null meta {
                                        xml::attributes = {
                                            w::val = 100
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "Chapter 1 introduces new terms that have been included through the implementation of ISO 20022 messaging."
                            ]
                        ]
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
                                            w::val = 1
                                        }
                                    }
                                    w::numId = null meta {
                                        xml::attributes = {
                                            w::val = 100
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "Chapter 2 provides a high level overview of the process for creating, settling and processing HVCS transactions."
                            ]
                        ]
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
                                            w::val = 1
                                        }
                                    }
                                    w::numId = null meta {
                                        xml::attributes = {
                                            w::val = 100
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "Chapter 3 provides an overview of the message formats and types of messages sent across the HVCS."
                            ]
                        ]
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
                                            w::val = 1
                                        }
                                    }
                                    w::numId = null meta {
                                        xml::attributes = {
                                            w::val = 100
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "Chapter 4 introduces Y-copy and HVCS message flows."
                            ]
                        ]
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
                                            w::val = 1
                                        }
                                    }
                                    w::numId = null meta {
                                        xml::attributes = {
                                            w::val = 100
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "Chapter 5 gives an overview of the organisations and systems involved in the HVCS clearing and settlement processes and their roles."
                            ]
                        ]
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
                                            w::val = 1
                                        }
                                    }
                                    w::numId = null meta {
                                        xml::attributes = {
                                            w::val = 100
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "Chapter 6 describes the legislation, contracts, and standards that apply to HVCS payments and some of the technical terms used by the HVCS."
                            ]
                        ]
                    ]
                ]
            ]
            w::p = [
                w::pPr = [
                    w::pStyle = null meta {
                        xml::attributes = {
                            w::val = "Heading2"
                        }
                    }
                ]
                w::r = [
                    w::t = "Documentation map"
