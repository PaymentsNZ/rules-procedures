                                        xml::attributes = {
                                            w::val = 100
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "If the debtor of an on-us SCP makes a request under sub-clause (1), the participant should give an on-us remitter confirmation to the debtor no more than 60 minutes after the debtor has made the request under sub-clause (1)."
                            ]
                        ]
                        w::p = [
