                            w::r = [
                                w::t = "If the debtor of an on-us SCP asks a participant to notify the debtor of the status of the on-us SCP, the participant should notify the debtor in accordance with subclauses (2) to (5) (on-us remitter confirmation)."
                            ]
                        ]
                        w::p = [
