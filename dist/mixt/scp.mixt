                                        xml::attributes = {
                                            w::val = 100
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "the date of the notification:"
                            ]
                        ]
                        w::p = [
                            w::pPr = [
                                w::numPr = [
                                    w::ilvl = null meta {
                                        xml::attributes = {
                                            w::val = 2
                                        }
                                    }
                                    w::numId = null meta {
                                        xml::attributes = {
                                            w::val = 100
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "a heading containing the words 'On-us Beneficiary notification' clearly at the top of the notification:"
                            ]
                        ]
                        w::p = [
