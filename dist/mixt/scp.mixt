                                        }
                                    }
                                    w::numId = null meta {
                                        xml::attributes = {
                                            w::val = 100
                                        }
                                    }
                                ]
                            ]
                            w::r = [
                                w::t = "If the participant tries to send the debtor the on-us remitter confirmation using an email address but the email is not delivered (because, for example, the email address is not valid), the participant is not required to:—"
                            ]
                        ]
                        w::p = [
