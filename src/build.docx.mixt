import [
	scp = "hvcs/scp.mixt"	
]
let
	iterate = (results as list, l as list) => (
		List.Accumulate(
			l,
			results
			( state, current ) => (
				if current == null then
					state
				else if Value.Is( current, type list ) then
					@iterate( state, current )
				else
					state & [
						current
					]
			)
		)
	)
	result = iterate( [], scp )
in
	result