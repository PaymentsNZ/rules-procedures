import [
	src = "example/common.mixt"
	htmltodocx = "docx/htmlToDocx.mixt"
	factory = "docx/factory.mixt"
	sampleContent = "docx/content/word/document.mixt"
]
let
	outputFileName = "createdByMixt.docx"
	translated = htmltodocx::translateDocument( src )
	writtenDOCX = factory::writeDocx( outputFileName, translated )
	writtenMIXT = File.Write(
		"createdByMixt.mixt"
		Mixt.FromValue(translated)
	)
	writtenXml = File.Write(
		"createdByMixt.xml"
		Xml.FromValue(translated)
	)	
in
	//writtenDOCX
	writtenMIXT
	//writtenXml
