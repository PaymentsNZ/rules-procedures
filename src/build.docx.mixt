import [
	src = "example/coexistence.mixt"
	htmltodocx = "docx/htmlToDocx.mixt"
	factory = "docx/factory.mixt"
	sampleContent = "docx/content/word/document.mixt"
]
let
	outputFileName = "createdByMixt.docx"
	translated = htmltodocx::translateDocument( src )
	written = factory::writeDocx( outputFileName, translated )
in
	written