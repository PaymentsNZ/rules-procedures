import [
	pnz = "pnz.legal.mixt"
	hvcs = "hvcs/hvcs.mixt"
	overview = "hvcs/overview.mixt"
	common = "hvcs/common.mixt"
	scp = "hvcs/scp.mixt"	
	mx = "hvcs/mx.mixt"
	mt = "hvcs/mt.mixt"
	coexistence = "hvcs/coexistence.mixt"
]

let
	//selector = null
	selector = (id as text) => true
	//selector = (id as text) => (id == "MX" or id == "Coexistence")
	documents = #table(
		[
			"id"
			"title"
			"target"
			"source"
		]
		[
			[
				"Overview"
				"HVCS Overview"
				"docs/hvcs/overview.html"
				overview
			]
			[
				"Common"
				"HVCS Common Procedures"
				"docs/hvcs/common.html"
				common
			]
			[
				"SCP"
				"HVCS SCP Procedures"
				"docs/hvcs/scp.html"
				scp
			]
			[
				"MX"
				"HVCS MX Procedures"
				"docs/hvcs/mx.html"
				mx
			]
			[
				"MT"
				"HVCS MT Procedures"
				"docs/hvcs/mt.html"
				mt
			]
			[
				"Coexistence"
				"HVCS Coexistence Procedures"
				"docs/hvcs/coexistence.html"
				coexistence
			]
		]
	),
	asRecords = Table.ToRecords(
		if selector == null then
			documents
		else
			Table.SelectRows(
				documents
				(doc) => selector( doc{ id } )
			)
	)
	written = List.Accumulate(
		asRecords
		{}
		( state, current ) => (
			Record.AddField(
				state
				current{ id }
				File.Write(
					current{ target }
					Html.FromValue(
						hvcs::document(
							current{ title }
							current{ source }
						)
					)
				)
			)
		)
	)
in
	written
