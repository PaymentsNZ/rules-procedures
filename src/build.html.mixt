import [
	pnz = "pnz.legal.mixt"
	nav = "navigate.mixt"
	hvcs = "hvcs/hvcs.mixt"
	overview = "hvcs/overview.mixt"
	common = "hvcs/common.mixt"
	scp = "hvcs/scp.mixt"	
	mx = "hvcs/mx.mixt"
	mt = "hvcs/mt.mixt"
	coexistence = "hvcs/coexistence.mixt"
]

let
	//selector = null
	selector = (id as text) => true
	//selector = (id as text) => (id == "MX" or id == "Coexistence")
	documentsTable = #table(
		[
			"id"
			"title"
			"target"
			"path"
			"source"
		]
		[
			[
				"Overview"
				"HVCS Overview"
				"overview.html"
				"docs/hvcs/"
				overview
			]
			[
				"Common"
				"HVCS Common Procedures"
				"common.html"
				"docs/hvcs/"
				common
			]
			[
				"SCP"
				"HVCS SCP Procedures"
				"scp.html"
				"docs/hvcs/"
				scp
			]
			[
				"MX"
				"HVCS MX Procedures"
				"mx.html"
				"docs/hvcs/"
				mx
			]
			[
				"MT"
				"HVCS MT Procedures"
				"mt.html"
				"docs/hvcs/"
				mt
			]
			[
				"Coexistence"
				"HVCS Coexistence Procedures"
				"coexistence.html"
				"docs/hvcs/"
				coexistence
			]
		]
	),
	docSet = Table.ToRecords(
		if selector == null then
			documentsTable
		else
			Table.SelectRows(
				documentsTable
				(doc) => selector( doc{ id } )
			)
	)
	written = List.Accumulate(
		docSet
		{}
		( state, current, docIndex ) => (
			let
				docContent = current{ source }
				chaptersAndClauses = nav::getChaptersAndClauses( docContent )
				result = Record.AddField(
					state
					current{ id }
					File.Write(
						FilePath.Join( current{ path }, current{ target } )
						Html.FromValue(
							hvcs::document(
								current{ title }
								docContent
								docIndex
								chaptersAndClauses
								docSet
							)
						)
					)
				)
			in
				result
		)
	)
in
	written
