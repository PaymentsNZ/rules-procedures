import [
	pnz = "html/pnz.legal.mixt"
	hvcs = "html/pnz.hvcs.mixt"
	nav = "html/navigate.mixt"
	documentsTable = "documents.mixt"
]

let
	//selector = null
	selector = (id as text) => true
	//selector = (id as text) => (id == "Coexistence")

	docSet = Table.ToRecords(
		if selector == null then
			documentsTable
		else
			Table.SelectRows(
				documentsTable
				(doc) => selector( doc{ id } )
			)
	)
	
	written = List.Accumulate(
		docSet
		{}
		( state, current, docIndex ) => (
			let
				docContent = current{ source }
				chaptersAndClauses = nav::getChaptersAndClauses( docContent )
				result = Record.AddField(
					state
					current{ id }
					File.Write(
						FilePath.Join( current{ path }, current{ target } )
						Html.FromValue(
							hvcs::document(
								current{ title }
								docContent
								docIndex
								chaptersAndClauses
								docSet
							)
						)
					)
				)
			in
				result
		)
	)
in
	written
