[
    xml::declaration = {
        version = "1.0"
        encoding = "UTF-8"
        standalone = "yes"
    }
	w::numbering = {
		xml::attributes = {
			xmlns::w = "http://schemas.openxmlformats.org/wordprocessingml/2006/main"
		}
	} @> [
		w::abstractNum = {
			xml::attributes = {
				w::abstractNumId = "1"
			}
		} @> [
			w::multiLevelType = {
				xml::attributes = {
					w::val = "singleLevel"
				}
			} @> null
			w::lvl = {
				xml::attributes = {
					w::ilvl = "0"
				}
			} @> [
				w::start = {
					xml::attributes = {
						w::val = "1"
					}
				} @> null
				
				w::numFmt = {
					xml::attributes = {
						w::val = "decimal"
					}
				} @> null
				
				w::lvlText = {
					xml::attributes = {
						w::val = "%1."
					}
				} @> null
				
				w::pPr = [
					w::ind = {
						xml::attributes = {
							w::left = "360"
							w::hanging = "360"
						}
					} @> null
				]
			]
		]

		w::num = {
			xml::attributes = {
				w::numId = "1"
			}
		} @> [
			w::abstractNumId = {
				xml::attributes = {
					w::val = "1"
				}
			} @> null
		]
	]
]
