import [
	xml = "../../xml.mixt"
]
[
    xml::declaration = {
        version = "1.0"
        encoding = "UTF-8"
        standalone = "yes"
    }
	w::numbering = xml::attributed(
		{
			xmlns::w = "http://schemas.openxmlformats.org/wordprocessingml/2006/main"
		}
		[
			// Default numbering style for legal documents (1)(a)(i)
			w::abstractNum = xml::attributed(
				{
					w::abstractNumId = "1"
				}
				[
					w::multiLevelType = xml::attributed({ w::val = "hybridMultilevel" })
					// ilvl 0: anchor – nothing displayed, required to enable resets to numbering
					// from the document
					w::lvl = xml::attributed(
						{
							w::ilvl = 0
						}
						[
							w::start = xml::attributed({ w::val = 1 })
							w::numFmt = xml::attributed({ w::val = "decimal" })
							w::lvlText = xml::attributed({ w::val = "" })
							w::suff = xml::attributed({ w::val = "none" })
							w::pPr = [
								w::ind = xml::attributed({ w::left = 0, w::hanging = 0 })
							]
						]
					)
					w::lvl = xml::attributed(
						{
							w::ilvl = 1
						}
						[
							w::start = xml::attributed({ w::val = 1 })
							w::numFmt = xml::attributed({ w::val = "decimal" })
							w::lvlText = xml::attributed({ w::val = "(%2)" })
							w::lvlRestart = xml::attributed({ w::val = 1 })
							w::suff = xml::attributed({ w::val = "tab" })
							w::lvlJc = xml::attributed({ w::val = "left" })
							w::pPr = [
								w::ind = xml::attributed({ w::left = 430, w::hanging = 430 })
							]
						]
					)
					w::lvl = xml::attributed(
						{
							w::ilvl = 2
						}
						[
							w::start = xml::attributed({ w::val = 1 })
							w::numFmt = xml::attributed({ w::val = "lowerLetter" })
							w::lvlText = xml::attributed({ w::val = "(%3)" })
							w::lvlRestart = xml::attributed({ w::val = 2 })
							w::suff = xml::attributed({ w::val = "tab" })
							w::lvlJc = xml::attributed({ w::val = "left" })
							w::pPr = [
								w::ind = xml::attributed({ w::left = 860, w::hanging = 430 })
							]
						]
					)
					w::lvl = xml::attributed(
						{
							w::ilvl = 3
						}
						[
							w::start = xml::attributed({ w::val = 1 })
							w::numFmt = xml::attributed({ w::val = "lowerRoman" })
							w::lvlText = xml::attributed({ w::val = "(%4)" })
							w::lvlRestart = xml::attributed({ w::val = 3 })
							w::suff = xml::attributed({ w::val = "tab" })
							w::lvlJc = xml::attributed({ w::val = "left" })
							w::pPr = [
								w::ind = xml::attributed({ w::left = 1290, w::hanging = 430 })
							]
						]
					)
				]
			)

			// Default bullets style for legal documents: •, ◦, -
			w::abstractNum = xml::attributed(
				{
					w::abstractNumId = "2"
				}
				[
					w::multiLevelType = xml::attributed({ w::val = "hybridMultilevel" })
					w::lvl = xml::attributed(
						{
							w::ilvl = 0
						}
						[
							w::start = xml::attributed({ w::val = 1 })
							w::numFmt = xml::attributed({ w::val = "bullet" })
							w::lvlText = xml::attributed({ w::val = "•" })  // U+2022
							w::suff = xml::attributed({ w::val = "tab" })
							w::pPr = [
								w::ind = xml::attributed({ w::left = 720, w::hanging = 360 })
							]
							// ensure the bullet uses Symbol font everywhere
							w::rPr = [
								w::rFonts = xml::attributed({ w::ascii = "Symbol", w::hAnsi = "Symbol" })
							]
						]
					)
					w::lvl = xml::attributed(
						{
							w::ilvl = 1
						}
						[
							w::start = xml::attributed({ w::val = 1 })
							w::numFmt = xml::attributed({ w::val = "bullet" })
							w::lvlText = xml::attributed({ w::val = "◦" })  // U+25E6 (alternatives: "○" U+25CB or "o")
							w::suff = xml::attributed({ w::val = "tab" })
							w::pPr = [
								w::ind = xml::attributed({ w::left = 1440, w::hanging = 360 })
							]
							w::rPr = [
								w::rFonts = xml::attributed({ w::ascii = "Symbol", w::hAnsi = "Symbol" })
							]
						]
					)
					w::lvl = xml::attributed(
						{
							w::ilvl = 2
						}
						[
							w::start = xml::attributed({ w::val = 1 })
							w::numFmt = xml::attributed({ w::val = "bullet" })
							w::lvlText = xml::attributed({ w::val = "\u2013" }) // U+2013, dash uses the body font
							w::suff = xml::attributed({ w::val = "tab" })
							w::lvlJc = xml::attributed({ w::val = "left" })
							w::pPr = [
								w::ind = xml::attributed({ w::left = 2160, w::hanging = 360 })
							]
						]
					)
				]
			)

			// Concrete instance of numbering
			w::num = xml::attributed(
				{ w::numId = 100 }
				[ w::abstractNumId = xml::attributed({ w::val = 1 }) ]
			)

			// Concrete instance of bullets
			w::num = xml::attributed(
				{ w::numId = 200 }
				[ w::abstractNumId = xml::attributed({ w::val = 2 }) ]
			)
		]
	)
]