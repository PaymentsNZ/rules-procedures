namespace htmltodocx

import [
	xml = "xml.mixt"
]

{
	skipOtherContent = true
	defaultNumbering = 100
	defaultBullets = 200
	htmlAttributes = Identifier.FromText( "html", "attributes" )

	// translateText
	translateText = (t as text) => (
		let
			removedTabs = Text.Transform( t, "\t", "" )
			replacedNewLines = Text.Transform( removedTabs, "\n", " ")
		in
			replacedNewLines
	)

	// getHtmlClass
	getHtmlClass = ( value as any ) => (
		if Value.HasMetadata( value ) then
			let
				attributes = Record.FieldOrDefault(
					Value.Metadata( value )
					Identifier.FromText( "html", "attributes" )
					null
				)
				class = (
					if attributes == null then
						null
					else
						Record.FieldOrDefault( attributes, "class", null )
				)
			in
				class
		else
			""
	)

	// addTag is a single-cell table styled as a tag
	addTag = (heading as text, fill as text) => [
		w::p = null
		w::tbl = [
			w::tblPr = [
				w::tblW       = xml::attributed({ w::type = "auto", w::w = 0 })
				w::tblBorders = [
				w::top    = xml::attributed({ w::val="nil" })
				w::left   = xml::attributed({ w::val="nil" })
				w::bottom = xml::attributed({ w::val="nil" })
				w::right  = xml::attributed({ w::val="nil" })
				w::insideH= xml::attributed({ w::val="nil" })
				w::insideV= xml::attributed({ w::val="nil" })
				]
				w::tblLayout  = xml::attributed({ w::type="auto" }) // no auto-reflow surprises
			]
			w::tr = [
				w::tc = [
				w::tcPr = [
					// Fit to content
					w::tcW = xml::attributed({ w::type="auto", w::w=300 })
					// Background fill (purple); use your brand color
					w::shd = xml::attributed({ w::val="clear", w::color="auto", w::fill=fill })
					// Padding (cell margins) ~5pt
					w::tcMar = [
					w::top    = xml::attributed({ w::w=100, w::type="dxa" })
					w::bottom = xml::attributed({ w::w=100, w::type="dxa" })
					w::left   = xml::attributed({ w::w=160, w::type="dxa" })
					w::right  = xml::attributed({ w::w=160, w::type="dxa" })
					]
				]
				w::p = [
					w::pPr = [ w::jc = xml::attributed({ w::val="center" }) ]
					w::r = [
						w::rPr = [
							w::b    = null
							w::color= xml::attributed({ w::val="FFFFFF" })
							// optional: force font/size
							// w::rFonts = xml::attributed({ w::ascii="Open Sans", w::hAnsi="Open Sans" })
							// w::sz = xml::attributed({ w::val=20 })
						]
						w::t = heading
					]
				]
				]
			]
		]
		w::p = null
	]

	// addSectionHeading
	addSectionHeading = ( state as list, heading as text ) => (
		state & [
			w::p = [
				w::pPr = [
					w::pStyle = xml::attributed({ w::val = "Heading1" })
				]
				w::r = [
					w::t = heading
				]
			]	
		]
	)

	// addSubsectionHeading
	addSubsectionHeading = ( state as list, heading as text ) => (
		state & [
			w::p = [
				w::pPr = [
					w::pStyle = xml::attributed({ w::val = "Heading2" })
				]
				w::r = [
					w::t = heading
				]
			]	
		]
	)

	// addTagCommentary
	addTagCommentary = ( state as list ) => (
		state & addTag( "Commentary", "7B3FC5" )
	)

	// addTagStandards
	addTagStandards = ( state as list ) => (
		state & addTag( "Standards", "009FDF" )
	)

	// addTagBestPractice
	addTagBestPractice = ( state as list ) => (
		state & addTag( "Best Practice", "00B050" )
	)

	// formatAndTranslateText
	formatAndTranslateText = ( t as text ) => (
		if Value.HasMetadata( t ) then
			let
				class = getHtmlClass( t )
				style = (
					if class == "bold" then
						[
							w::rPr = [
								w::b = null
							]
						]
					else if class == "italic" then
						[
							w::rPr = [
								w::i = null
							]
						]
					else
						[]
				)
			in
				style & [
					w::t = translateText( t )
				]
		else
			[
				w::t = translateText( t )
			]
	)

	// joinParagraphText
	joinParagraphText = ( runs as list, t as text ) => (
		if List.Count( runs ) == 0 then
			runs & [
				w::r = formatAndTranslateText( t )
			]
		else
			runs & [
				w::r = [
					w::t = xml::attributed({ xml::space = "preserve" }, " " )
				]
				w::r = formatAndTranslateText( t )
			]
	)

	// getParagraphText
	getParagraphText = ( state as list, content as list ) => (
		List.Accumulate(
			content
			state
			( state, value, itemIndex, fieldName ) => (
				if value == null then
					state
				else if Value.Is( value, type list ) then
					@getParagraphText( state, value )
				else if Value.Is( value, type text ) then
					joinParagraphText( state, value )
				else
					List.AddItem(
						state
						fieldName
						value
					)
			)
		)
	)

	// getParagraphs
	getParagraphs = (value as list) => (
		let
			spans = List.Select(
				value
				(childValue as any, itemIndex as number, fieldName as text) => fieldName == "span"
			)
			paragraphs = (
				if List.Count( spans ) == List.Count( value ) then
					[
						w::p = getParagraphText( [], value )
					]
				else
					iterate( [], "paragraphs", value )
			)
		in
			paragraphs
	)

	// addBulletsForLevel
	addBulletsForLevel = ( state as list, level as number, paragraphs as list ) => (
		List.Accumulate(
			paragraphs
			state
			( state, value, itemIndex, fieldName ) => (
				let
					class = getHtmlClass( value )
					result = (
						if value == null then
							state
						else if class == "doc-comment" or class == "doc-question" then
							state
						else if Value.Is( value, type list ) then
							if fieldName == "ul" then
								@addBulletsForLevel( state, level + 1, value )
							else
								state & [
									w::p = [
										w::pPr = [
											w::numPr = [
												w::ilvl = xml::attributed( { w::val = level } )
												w::numId = xml::attributed( { w::val = defaultBullets } )
											]
										]
									] & getParagraphText( [], value )
								]
						else if Value.Is( value, type text ) then
							state & [
								w::p = [
									w::pPr = [
										w::numPr = [
											w::ilvl = xml::attributed( { w::val = level } )
											w::numId = xml::attributed( { w::val = defaultBullets } )
										]
									]
									w::r = formatAndTranslateText( value )
								]
							]
						else
							transformValue( state, fieldName, itemIndex, value )
					)
				in
					result
			)
		)
	)

	// addBullets
	addBullets = ( state as list, value as list ) => (
		addBulletsForLevel( state, 0, value )
	)

	// addNumberingForLevel
	addNumberingForLevel = ( state as list, level as number, paragraphs as list ) => (
		List.Accumulate(
			paragraphs
			state
			( state, value, itemIndex, fieldName ) => (
				if value == null then
					state
				else if Value.Is( value, type list ) then
					if fieldName == "ol" then
						@addNumberingForLevel( state, level + 1, value )
					else if fieldName == "ul" then
						addBullets( state, value )
					else if fieldName == "div" then
						let
							class = getHtmlClass( value )
						in
							if class == "doc-comment" or class == "doc-question" then
								state
							else
								@addNumberingForLevel( state, level, value )
					else
						state & [
							w::p = [
								w::pPr = [
									w::numPr = [
										w::ilvl = xml::attributed( { w::val = level } )
										w::numId = xml::attributed( { w::val = defaultNumbering } )
									]
								]
							] & getParagraphText( [], value )
						]
				else if Value.Is( value, type text ) then
					state & [
						w::p = [
							w::pPr = [
								w::numPr = [
									w::ilvl = xml::attributed( { w::val = level } )
									w::numId = xml::attributed( { w::val = defaultNumbering } )
								]
							]
							w::r = formatAndTranslateText( value )
						]
					]
				else
					transformValue( state, fieldName, itemIndex, value )
			)
		)
	)

	// addNumbering
	addNumbering = ( state as list, value as list ) => (
		addNumberingForLevel( state, 1, value )
	)

	// transformTable
	transformTable = (state as list, t as table ) => (
		let
			columnNames = Table.ColumnNames( t )
			columnCount = List.Count( columnNames )
			transformed = [
				w::tbl = [
					w::tblPr = [
						// Percentages are expressed in 1/50th of a percent.
						w::tblW = xml::attributed({ w::type = "pct", w::w = 5000 })
						w::jc = xml::attributed({ w::val="left" }) // Alignment: left
						w::tblBorders = [
							w::top     = xml::attributed({ w::val = "single", w::sz = 4, w::color = "000000" })
							w::left    = xml::attributed({ w::val = "single", w::sz = 4, w::color = "000000" })
							w::bottom  = xml::attributed({ w::val = "single", w::sz = 4, w::color = "000000" })
							w::right   = xml::attributed({ w::val = "single", w::sz = 4, w::color = "000000" })
							w::insideH = xml::attributed({ w::val = "single", w::sz = 4, w::color = "000000" })
							w::insideV = xml::attributed({ w::val = "single", w::sz = 4, w::color = "000000" })
						]
					]
					w::tblGrid = List.Transform(
						columnNames
						(columnName) => #(w::gridCol = xml::attributed(
							{ w::w = 1000 } // Sizing hints
						))
					)
					w::tr = List.Transform(
						columnNames
						(columnName) => #(w::tc = [
							w::p = [
								w::r = [
									w::rPr = [
										w::b = null
									]
									w::t = columnName
								]
							]
						])
					)
				] & List.Transform(
					Table.ToRecords(t)
					(r as record) => #(w::tr =
						List.Transform(
							Record.FieldNames(r)
							(fieldName as any, fieldIndex as number) => #(w::tc = 
								(
									let
										// fieldName is not relevant in this context
										content = transformValue( [], "", fieldIndex, Record.Field( r, fieldName ))
									in
										if List.Count( content ) == 0 then
											[
												w::p = null
											]
										else
											content
								)
							)
						)
					)
				)
				// https://stackoverflow.com/questions/74989943/why-do-i-get-word-found-unreadable-content-in-doc-when-adding-a-nested-table
				w::p = null
			] 
		in
			state & transformed
	)

	// transformValue
	transformValue = ( state as list, fieldName as text, itemIndex as number, value as any ) => (
		if Value.Is( value, type text ) then
			let
				class = getHtmlClass( value )
				added = (
					if class == "" and fieldName == "" then
						state & [
							w::p = [
								w::r = formatAndTranslateText( value )
							]
						]
					else if class == "section-heading" then
						addSectionHeading( state, translateText( value ) )
					else if class == "subsection-heading" then
						addSubsectionHeading( state, translateText( value ) )
					else if class == "tag-commentary" then
						addTagCommentary( state )
					else if class == "tag-bestpractice" then
						addTagBestPractice( state )
					else if class == "tag-standards" then
						addTagStandards( state )
					else if class == "bullets" then
						addBullets( state, value )
					else if skipOtherContent then
						state
					else if Value.HasMetadata( value ) then
						List.AddItem(
							state
							fieldName
							translateText( value ) meta Value.Metadata( value )
						)					
					else
						List.AddItem(
							state
							fieldName & "!!!"
							translateText( value )
						)
				)
			in
				added
		else if Value.Is( value, type number ) then
			state & [
				w::p = [
					w::r = formatAndTranslateText( Text.From( value) )
				]
			]		
		else if Value.Is( value, type list ) then
			iterate( state, fieldName, value )
		else if Value.Is( value, type record ) then
			iterate( state, fieldName, value )
		else if Value.Is( value, type table ) then
			transformTable( state, value )
		else if skipOtherContent then
			state
		else
			// TODO: Add support for tables
			List.AddItem( state, fieldName & "???", value )
	)

	// getClauseNumber
	getClauseNumber = ( value as any ) => (
		if Value.HasMetadata( value ) then
			let
				attributes = Record.FieldOrDefault(
					Value.Metadata( value )
					Identifier.FromText( "html", "attributes" )
					null
				)
				clauseNumber = (
					if attributes == null then
						null
					else
						Record.FieldOrDefault( attributes, "data-number", null )
				)
			in
				clauseNumber
		else
			""
	)

	// addClause
	addClause = (contents as list) => (
		let
			first = List.FirstOrDefault( contents, "" )
			clauseNumber = getClauseNumber( first )
			fullClause = (
				if clauseNumber == "" then
					first & "" // Remove metadata
				else
					$"$(clauseNumber) $(first)"
			)
			subsequent = List.RemoveFirstN( contents, 1 )
			// 1 cm = 1440 / 2.54 ≈ 566.929 twips
			result = [
				w::tbl = [
					w::tblPr = [
						// FIXED layout + exact table width in twips
						w::tblW = xml::attributed({ w::type = "dxa", w::w = 9638 }) //  preferred width: 17 cm
						w::jc = xml::attributed({ w::val="left" }) // Alignment: left
						w::tblInd = xml::attributed({ w::type = "dxa", w::w="0" }) // Indent from left: 0 cm
						w::tblLayout = xml::attributed({ w::type = "fixed" }) // Respect exact column widths
					]
					w::tblGrid = [
						w::gridCol = xml::attributed({ w::w = 1701 })  // 3 cm
						w::gridCol = xml::attributed({ w::w = 7937 })  // 14 cm
					]
					w::tr = [
						w::tc = [
							w::p = [
								// Reset numbering for each clause
								w::pPr = [
									w::numPr = [
										w::ilvl = xml::attributed( { w::val = 0 } )
										w::numId = xml::attributed( { w::val = defaultNumbering } )
									]
								]
							] & (
								if fullClause == "" then
									[]
								else
									[
										w::r = [
											w::rPr = [
												w::b = null
											]
											w::t = fullClause
										]
									]
							)
						]
						w::tc = (
							let
								children = iterate( [], "clause", subsequent )
							in
								if List.Count(children) == 0 then
									[
										w::p = null
									]
								else
									children
						)
					]
				]
			]
			w::p = null
		in
			result
	)

	// accumulatePieces
	accumulatePieces = (l as list) => (
		let
			accumulated = List.Accumulate(
				l,
				{
					runs = []
					items = []
				}
				( state, value, itemIndex, fieldName ) => (
					if value == null then
						state
					else if fieldName == "span" and Value.Is( value, type text ) then
						state & {
							runs = joinParagraphText( state{ runs }, value )
						}
					else 
						let
							combinedItems = (
								if List.Count( state{ runs } ) == 0 then
									state{ items }
								else
									state{ items } & [
										w::p = state{ runs }
									]
							)
							transformed = (
								if Value.Is( value, type list ) then
									@iterate( [], fieldName, value )
								else if Value.Is( value, type record ) then
									@iterate( [], fieldName, value )
								else
									transformValue( [], fieldName, itemIndex, value )
							)
						in
							{
								runs = []
								items = combinedItems & transformed
							}
				)
			)
			// Handle if we finished with one or more spans
			combined = (
				if List.Count( accumulated{ runs } ) == 0 then
					accumulated{ items }
				else
					accumulated{ items } & [
						w::p = accumulated{ runs }
					]
			)
		in
			combined
	)

	// iterate
	iterate = (results as list, id as text, container as any) => (
		let
			class = getHtmlClass( container )
			added = (
				if class == "logo"  or class == "doc-comment" or class == "doc-question" then
					results
				else if class == "menu-container" then
					results					
				else if class == "clause-row" then
					results & addClause( container )
				else if Value.Is( container, type list ) then
					if List.Count( container ) == 0 then
						results
					else if id == "ol" and Text.StartsWith( class, "level1" ) then
						addNumbering( results, container )
					else if id == "ul" and Text.StartsWith( class, "bullets" ) then
						addBullets( results, container )
					else if List.Count( container ) == 0 then
						results
					else
						results & accumulatePieces( container )
				else if Value.Is( container, type table ) then
					transformTable( results, container )
				else if Record.FieldCount( container ) == 0 then
					results
				else
					List.Accumulate(
						Record.FieldNames( container )
						results
						( state, fieldName, itemIndex ) => (
							let
								value = Record.Field( container, fieldName )
								result = (
									if value == null then
										state
									else if Value.Is( value, type list ) then
										@iterate( state, fieldName, value )
									else if Value.Is( value, type record ) then
										@iterate( state, fieldName, value )
									else
										transformValue( state, fieldName, itemIndex, value )
								)
							in
								result
						)
					)
			)
		in
			added
	)

	// wrapContents
	wrapContents = ( body as list ) => [
		xml::declaration = {
			version = "1.0"
			encoding = "UTF-8"
			standalone = "yes"
		}
		w::document = {
			xml::attributes = { xmlns::w = "http://schemas.openxmlformats.org/wordprocessingml/2006/main" }
		} @> [
			w::body = body & [
				// last child of w:body
				w::sectPr = [
					// A4 portrait: 210 mm × 297 mm
					w::pgSz  = xml::attributed({ w::w = 11906, w::h = 16838 })
					// Margins: top/bottom 2.5cm, left/right 2.2cm
					w::pgMar = xml::attributed({
						w::top    = 1417
						w::bottom = 1417
						w::left   = 1247
						w::right  = 1247
						// header/footer/gutter can be left to defaults
					})
				]
			]
		]
	]

	// sampleBody
	sampleBody = [
		w::p = [
			w::r = [
				w::t = "Hello, DOCX"
			]
		]
		w::sectPr = null
	]

	// htmltodocx::translateDocument
	htmltodocx::translateDocument = ( doc as list ) => (
		let
			body = iterate( [], "root", doc )
			wrapped = wrapContents( body )
			written = File.Write(
				"translated.mixt"
				wrapped
			)
		in
			wrapped
	)
}
