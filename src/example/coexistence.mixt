[
    div = {
        img = "" meta {
            html::attributes = {
                src = "../images/PNZ_OnWhite_rgb.gif"
                alt = "PNZ Logo"
            }
        }
    } meta {
        html::attributes = {
            class = "logo"
        }
    }
    [
        div = "Appendix 14F: HVCS Co-existence Procedures (UG2025)" meta {
            html::attributes = {
                class = "document-title"
            }
        }
        div = "Version 3" meta {
            html::attributes = {
                class = "document-meta"
            }
        }
        div = "Effective date: 22/11/2025" meta {
            html::attributes = {
                class = "document-meta"
            }
        }
    ]
    h1 = "Document purpose and overview" meta {
        html::attributes = {
            id = "document-purpose-and-overview"
            class = "section-heading"
        }
    }
    div = "" meta {
        html::attributes = {
            class = "tag-commentary"
        }
    }
    div = [
        div = "HVCS rules and procedures overview" meta {
            html::attributes = {
                id = "hvcs-rules-and-procedures-overview"
                class = "clause-heading"
                data-number = ""
            }
        }
        ol = [
            div = [
                "This document, the Co-Existence Procedures (Part F) is one part of a suite of documentation\n\t\t\tto help participants understand what is required to become a high value clearing system (HVCS)\n\t\t\tparticipant and how to send and receive individual HVCS instructions and NZD HVCS payments that\n\t\t\tthe participant cannot revoke or reverse after settlement."
            ]
        ] meta {
            html::attributes = {
                class = "level1 level1-counter-reset"
            }
        }
    ] meta {
        html::attributes = {
            class = "clause-row"
        }
    }
    [
        div = [
            div = [
                "Payments NZ Rules"
                "Part 9"
                "HVCS Clearing and Settlement"
            ] meta {
                html::attributes = {
                    class = "menu-root"
                }
            }
            div = [
                a = [
                    "Part A"
                    "HVCS Overview"
                ] meta {
                    html::attributes = {
                        href = "overview.html"
                        class = "menu-branch"
                    }
                }
                a = [
                    "Part B"
                    "HVCS Common Procedures"
                ] meta {
                    html::attributes = {
                        href = "common.html"
                        class = "menu-branch"
                    }
                }
                a = [
                    "Part C"
                    "SCP Procedures"
                ] meta {
                    html::attributes = {
                        href = "scp.html"
                        class = "menu-branch"
                    }
                }
                a = [
                    "Part D"
                    "MX Messaging Procedures (ISO 20022)"
                ] meta {
                    html::attributes = {
                        href = "mx.html"
                        class = "menu-branch"
                    }
                }
                a = [
                    "Part E"
                    "MT Messaging Procedures (ISO 15022)"
                ] meta {
                    html::attributes = {
                        href = "mt.html"
                        class = "menu-branch"
                    }
                }
                a = [
                    "Part F"
                    "Co-existence Procedures"
                ] meta {
                    html::attributes = {
                        href = "coexistence.html"
                        class = "menu-branch active"
                    }
                }
            ] meta {
                html::attributes = {
                    class = "menu-branches"
                }
            }
        ] meta {
            html::attributes = {
                class = "menu-container"
            }
        }
        div = "Diagram 01: HVCS Rules and Procedures documentation structure" meta {
            html::attributes = {
                class = "menu-caption"
            }
        }
    ]
    div = [
        div = "" meta {
            html::attributes = {
                id = ""
                class = "clause-heading"
                data-number = ""
            }
        }
        div = [
            "This document should be read in conjunction with the Payments NZ Rules (in particular, Part 9).\n\t\tPart 9 contains the HVCS clearing and settlement rules which specify the requirements for participants\n\t\tto create, exchange, settle, deliver and receive HVCS instructions and make HVCS payments (including\n\t\tSCPs) through HVCS. Part 2 contains the access and participation rules for an entity to join HVCS."
            "\tIn addition to the Rules, the applicable HVCS standards (Appendix 14) which specify how participants\n\t\tcomply with Part 9 are comprised of:"
            ul = [
                "Part A — HVCS Overview"
                ul = [
                    "Provides a high-level overview of the HVCS community, message types, how HVCS clearing and\n\t\t\t\tsettlement works, and the business, technical, and regulatory environment in which the process\n\t\t\t\toperates.  This is a non-binding document for use as guidance only."
                ]
                "Part B — HVCS Common Procedures"
                ul = [
                    "Provides binding procedures and product requirements that apply to all HVCS instructions\n\t\t\t\tat all times.  This document also contains some non-binding commentary and best practice."
                ]
                "Part C — SCP Procedures"
                ul = [
                    "Provides binding procedures and product requirements that apply only to an HVCS instruction\n\t\t\t\tthat is a same day cleared payment.  This document also contains some non-binding commentary\n\t\t\t\tand best practice, such as recommended terms and conditions with customers."
                ]
                "Part D — MX Messaging Procedures"
                ul = [
                    "Provides binding procedures on how to send and receive MX messages (ie, NZ HVCS ISO 20022\n\t\t\t\tmessages) across the HVCS MX CUG.  This document also contains some non-binding commentary\n\t\t\t\tand best practice."
                ]
                "Part E — MT Messaging Procedures"
                ul = [
                    "Provides binding procedures on how to send and receive MT messages (ie, NZ HVCS ISO 15022\n\t\t\t\tmessages) across the HVCS MT CUG.  This document also contains some non-binding commentary\n\t\t\t\tand best practice."
                ]
                "Part F — Co-existence Procedures (this document)"
                ul = [
                    "Provides binding procedures for participants during the co-existence phase of the migration\n\t\t\t\tfrom sending and receiving MT messages to MX messages."
                ]
            ] meta {
                html::attributes = {
                    class = "bullets"
                }
            }
        ] meta {
            html::attributes = {
                class = "level1"
            }
        }
    ] meta {
        html::attributes = {
            class = "clause-row"
        }
    }
    div = [
        div = "Standards, best practices and commentary" meta {
            html::attributes = {
                id = "standards-best-practices-and-commentary"
                class = "clause-heading"
                data-number = ""
            }
        }
        ol = [
            p = [
                "For information on how to determine whether the content of an applicable HVCS standard in Appendix\n\t\t\t14 creates binding legal rights or obligations, please see"
                span = "Part A - Overview." meta {
                    html::attributes = {
                        class = "italic"
                    }
                }
            ]
            p = [
                "Notwithstanding anything in clause 1.8 of the Rules or in Part A — Overview, any reference to\n\t\t\tactions a person \"should\" take or anything a person \"should\" do is intended to convey a best practice\n\t\t\twith which a person should comply with only, but which has no legal effect."
            ]
        ] meta {
            html::attributes = {
                class = "level1 level1-counter-reset"
            }
        }
    ] meta {
        html::attributes = {
            class = "clause-row"
        }
    }
    div = [
        div = "Document purpose and structure" meta {
            html::attributes = {
                id = "document-purpose-and-structure"
                class = "clause-heading"
                data-number = ""
            }
        }
        ol = [
            "This document discusses the obligations that apply to participants during the co-existence period."
            "This document is divided into five chapters."
            "Chapter 1 provides defined terms, an overview of the HVCS instructions that are in scope during\n\t\tco-existence, the migration timeline and the obligations to send and receive HVCS instructions that\n\t\tapply to participants."
            div = [
                div = [
                    span = "UG2025" meta {
                        html::attributes = {
                            class = "doc-comment-id"
                        }
                    }
                    span = "RK" meta {
                        html::attributes = {
                            class = "doc-comment-initials"
                        }
                    }
                ] meta {
                    html::attributes = {
                        class = "doc-comment-meta"
                    }
                }
                div = [
                    "Removed reference to MT"
                ] meta {
                    html::attributes = {
                        class = "doc-comment-content"
                    }
                }
            ] meta {
                html::attributes = {
                    class = "doc-comment"
                    data-change-id = "UG2025"
                }
            }
            "Chapter 2 provides information on how to join the MX CUG and specifies the types of BICs that can be used."
            "Chapter 3 provides an overview on the New Zealand HVCS's approach to structured data during co-existence,\n\t\tand the approach of CBPR+."
            div = [
                div = [
                    span = "UG2025" meta {
                        html::attributes = {
                            class = "doc-comment-id"
                        }
                    }
                    span = "RK" meta {
                        html::attributes = {
                            class = "doc-comment-initials"
                        }
                    }
                ] meta {
                    html::attributes = {
                        class = "doc-comment-meta"
                    }
                }
                div = [
                    "Removed reference to intermediaries (forwarding data paragraphs removed from chapter 4)."
                ] meta {
                    html::attributes = {
                        class = "doc-comment-content"
                    }
                }
            ] meta {
                html::attributes = {
                    class = "doc-comment"
                    data-change-id = "UG2025"
                }
            }
            "Chapter 4 provides an overview on data truncation."
            "Chapter 5 has been deleted."
            "Chapter 6 has been deleted."
            "Chapter 7 provides a temporary right for participants to receive and process MT payment messages for 4 weeks\n\t\tfrom the beginning of the co-existence phase."
        ] meta {
            html::attributes = {
                class = "level1 level1-counter-reset"
            }
        }
    ] meta {
        html::attributes = {
            class = "clause-row"
        }
    }
    h1 = "Chapter 1: The journey from MT to MX" meta {
        html::attributes = {
            id = "chapter-1-the-journey-from-mt-to-mx"
            class = "section-heading"
        }
    }
    div = "" meta {
        html::attributes = {
            class = "tag-commentary"
        }
    }
    div = [
        div = "Introduction" meta {
            html::attributes = {
                id = "1.1-introduction"
                class = "clause-heading"
                data-number = "1.1"
            }
        }
        ol = [
            "This chapter gives an overview of:"
            ol = [
                "the HVCS instructions (MT and MX messages) that are in scope during the co-existence phase,"
                "the timeline for migrating HVCS instructions as an MT message to an MX message,"
                div = [
                    div = [
                        span = "UG2025" meta {
                            html::attributes = {
                                class = "doc-comment-id"
                            }
                        }
                        span = "RK" meta {
                            html::attributes = {
                                class = "doc-comment-initials"
                            }
                        }
                    ] meta {
                        html::attributes = {
                            class = "doc-comment-meta"
                        }
                    }
                    div = [
                        "Changed to 'applicable message standards'."
                    ] meta {
                        html::attributes = {
                            class = "doc-comment-content"
                        }
                    }
                ] meta {
                    html::attributes = {
                        class = "doc-comment"
                        data-change-id = "UG2025"
                    }
                }
                "the obligations for participants to send and receive HVCS instructions in accordance with the\n\t\t\tapplicable message standards,"
                div = [
                    div = [
                        span = "UG2025" meta {
                            html::attributes = {
                                class = "doc-comment-id"
                            }
                        }
                        span = "RK" meta {
                            html::attributes = {
                                class = "doc-comment-initials"
                            }
                        }
                    ] meta {
                        html::attributes = {
                            class = "doc-comment-meta"
                        }
                    }
                    div = [
                        "Changed:"
                        "From: MX messaging will go live."
                        "To: when Standards are introduced and revoked."
                    ] meta {
                        html::attributes = {
                            class = "doc-comment-content"
                        }
                    }
                ] meta {
                    html::attributes = {
                        class = "doc-comment"
                        data-change-id = "UG2025"
                    }
                }
                "dates and times when Standards are introduced and revoked."
            ] meta {
                html::attributes = {
                    class = "level2 level2-counter-reset"
                }
            }
        ] meta {
            html::attributes = {
                class = "level1 level1-counter-reset"
            }
        }
    ] meta {
        html::attributes = {
            class = "clause-row"
        }
    }
    div = "" meta {
        html::attributes = {
            class = "tag-standards"
        }
    }
    div = [
        div = "Defined terms" meta {
            html::attributes = {
                id = "1.2-defined-terms"
                class = "clause-heading"
                data-number = "1.2"
            }
        }
        div = [
            div = [
                div = [
                    span = "UG2025" meta {
                        html::attributes = {
                            class = "doc-comment-id"
                        }
                    }
                    span = "RK" meta {
                        html::attributes = {
                            class = "doc-comment-initials"
                        }
                    }
                ] meta {
                    html::attributes = {
                        class = "doc-comment-meta"
                    }
                }
                div = [
                    "Revised for second coexistence phase November 2025 to November 2026."
                ] meta {
                    html::attributes = {
                        class = "doc-comment-content"
                    }
                }
            ] meta {
                html::attributes = {
                    class = "doc-comment"
                    data-change-id = "UG2025"
                }
            }
            [
                span = "Co-existence phase" meta {
                    html::attributes = {
                        class = "bold"
                    }
                }
                span = "means the period determined by Payments NZ in which the MT Messaging\n\t\t\t\tProcedures, the MX Messaging Procedures, the MX Message Specifications and these Co-existence\n\t\t\t\tProcedures all apply simultaneously beginning on 22 November 2025 and ending on a date:"
            ]
            ol = [
                "in November 2026; or"
                "as determined by Payments NZ if all participants have fully migrated to using MX messages\n\t\t\tprior to November 2026."
            ] meta {
                html::attributes = {
                    class = "level2 level2-counter-reset"
                }
            }
            [
                span = "On-send" meta {
                    html::attributes = {
                        class = "bold"
                    }
                }
                span = "means when a participant, in its capacity as an intermediary:"
            ]
            ol = [
                "receives an MX message from another participant destined for a third party recipient and sends\n\t\t\tthat message as a CBPR+ message to that recipient;"
                "receives an MT message from another participant destined for a third party recipient and sends\n\t\t\tthat message as a CBPR+ message or a FIN message to that recipient;"
                div = [
                    div = [
                        span = "UG2025" meta {
                            html::attributes = {
                                class = "doc-comment-id"
                            }
                        }
                        span = "RK" meta {
                            html::attributes = {
                                class = "doc-comment-initials"
                            }
                        }
                    ] meta {
                        html::attributes = {
                            class = "doc-comment-meta"
                        }
                    }
                    div = [
                        "Removed 'subject to clause 1.7(7)(a)(iv)of these Co-existence Procedures'\n\t\t\t\t- superfluous"
                    ] meta {
                        html::attributes = {
                            class = "doc-comment-content"
                        }
                    }
                ] meta {
                    html::attributes = {
                        class = "doc-comment"
                        data-change-id = "UG2025"
                    }
                }
                "receives a CBPR+ message destined for another participant and sends that message as an MX message\n\t\t\tto that participant; or"
                "receives a FIN message destined for another participant and sends that message as an HVCS\n\t\t\tinstruction to that participant."
            ] meta {
                html::attributes = {
                    class = "level2 level2-counter-reset"
                }
            }
            [
                span = "Send" meta {
                    html::attributes = {
                        class = "bold"
                    }
                }
                span = "means when an instructing agent delivers an HVCS instruction to an instructed agent,\n\t\t\t\tbeing either:"
            ]
            ol = [
                "a payment message; or"
                "an exception and investigation message."
            ] meta {
                html::attributes = {
                    class = "level2 level2-counter-reset"
                }
            }
            [
                span = "Structured Postal Address formatting" meta {
                    html::attributes = {
                        class = "bold"
                    }
                }
                span = "means when the content of the address information within an MX message is formatted in\n\t\t\t\taccordance with the structured data requirements set out in the MX Message Specifications."
            ]
            [
                span = "Unstructured Address Line formatting" meta {
                    html::attributes = {
                        class = "bold"
                    }
                }
                span = "means when the content of the address information within an MX message is not formatted in\n\t\t\t\taccordance with the structured data requirements set out in the MX Message Specifications."
            ]
            div = [
                div = [
                    span = "UG2025" meta {
                        html::attributes = {
                            class = "doc-comment-id"
                        }
                    }
                    span = "RK" meta {
                        html::attributes = {
                            class = "doc-comment-initials"
                        }
                    }
                ] meta {
                    html::attributes = {
                        class = "doc-comment-meta"
                    }
                }
                div = [
                    "Added Hybrid Address Line formatting."
                ] meta {
                    html::attributes = {
                        class = "doc-comment-content"
                    }
                }
            ] meta {
                html::attributes = {
                    class = "doc-comment"
                    data-change-id = "UG2025"
                }
            }
            [
                span = "Hybrid Address Line formatting" meta {
                    html::attributes = {
                        class = "bold"
                    }
                }
                span = "means when the content of the address information within an MX message is formatted in\n\t\t\t\taccordance with the hybrid data requirements set out in the MX Message Specifications."
            ]
            "Unless the context otherwise specifies, all other defined terms have the meanings given to them in\n\t\tPart 19 of the Payments NZ Rules and the HVCS Common Procedures."
        ] meta {
            html::attributes = {
                class = "level1"
            }
        }
    ] meta {
        html::attributes = {
            class = "clause-row"
        }
    }
    div = "" meta {
        html::attributes = {
            class = "tag-commentary"
        }
    }
    div = [
        div = "Payment message scope" meta {
            html::attributes = {
                id = "1.3-payment-message-scope"
                class = "clause-heading"
                data-number = "1.3"
            }
        }
        ol = [
            "The payment messages described below are in scope during the co-existence phase."
            div = [
                div = [
                    span = "UG2025" meta {
                        html::attributes = {
                            class = "doc-comment-id"
                        }
                    }
                    span = "RK" meta {
                        html::attributes = {
                            class = "doc-comment-initials"
                        }
                    }
                ] meta {
                    html::attributes = {
                        class = "doc-comment-meta"
                    }
                }
                div = [
                    "Removed:"
                    "Participants will still be required to comply with all existing obligations in relation \n\t\t\tto receiving and processing MT messages until the end of the co-existence phase (currently scheduled\n\t\t\tfor November 2025)."
                ] meta {
                    html::attributes = {
                        class = "doc-comment-content"
                    }
                }
            ] meta {
                html::attributes = {
                    class = "doc-comment"
                    data-change-id = "UG2025"
                }
            }
            "This table identifies new obligations that participants need to comply with in relation to MX\n\t\tmessages."
        ] meta {
            html::attributes = {
                class = "level1 level1-counter-reset"
            }
        }
    ] meta {
        html::attributes = {
            class = "clause-row"
        }
    }
    div = [
        "Messages exchanged between SWIFT message transfer service and participants:"
    ]
    div = [
        div = [
            span = "UG2025" meta {
                html::attributes = {
                    class = "doc-comment-id"
                }
            }
            span = "RK" meta {
                html::attributes = {
                    class = "doc-comment-initials"
                }
            }
        ] meta {
            html::attributes = {
                class = "doc-comment-meta"
            }
        }
        div = [
            "New content"
        ] meta {
            html::attributes = {
                class = "doc-comment-content"
            }
        }
    ] meta {
        html::attributes = {
            class = "doc-comment"
            data-change-id = "UG2025"
        }
    }
    div = {
        ;table = #table(
            type table {
                ;MX message = any
                ;NZ HVCS timing = any
                ;(CBPR+ timing) = any
            }
            [
                [
                    [
                        "pacs.008"
                        "pacs.009 CORE"
                        "pacs.009 COV"
                        "pacs.004"
                        "camt.056"
                        "camt.029"
                    ]
                    [
                        div = [
                            "By the beginning of the co-existence phase:"
                        ] meta {
                            html::attributes = {
                                class = "bold"
                            }
                        }
                        "Participants must be able to receive and process MX messages that use\n\t\t\t\t\t\thybrid postal address formatting."
                        br = null
                        div = [
                            "By the end of the co-existence phase:"
                        ] meta {
                            html::attributes = {
                                class = "bold"
                            }
                        }
                        "Participants must send all messages using either structured postal\n\t\t\t\t\t\taddress formatting or hybrid postal address formatting."
                    ]
                    [
                        div = [
                            "By the beginning of the co-existence phase:"
                        ] meta {
                            html::attributes = {
                                class = "bold"
                            }
                        }
                        "Participants acting as intermediaries must be able to receive and process\n\t\t\t\t\t\tCBPR+ messages that use hybrid postal address formatting."
                        div = [
                            div = [
                                span = "UG2025" meta {
                                    html::attributes = {
                                        class = "doc-comment-id"
                                    }
                                }
                                span = "RK" meta {
                                    html::attributes = {
                                        class = "doc-comment-initials"
                                    }
                                }
                            ] meta {
                                html::attributes = {
                                    class = "doc-comment-meta"
                                }
                            }
                            div = [
                                "Removed 'subject to clause 1.7(7)(a)(iv)'\n\t\t\t\t\t\t\t- superfluous"
                            ] meta {
                                html::attributes = {
                                    class = "doc-comment-content"
                                }
                            }
                        ] meta {
                            html::attributes = {
                                class = "doc-comment"
                                data-change-id = "UG2025"
                            }
                        }
                        "Participants acting as intermediaries must be able to on-send a CBPR+ message\n\t\t\t\t\t\tthat uses hybrid postal address formatting to participants as an MX message."
                        br = null
                        div = [
                            "By the end of the co-existence phase:"
                        ] meta {
                            html::attributes = {
                                class = "bold"
                            }
                        }
                        "Participants acting as intermediaries must send all CBPR+ messages and on-send\n\t\t\t\t\t\tall CBPR+ messages to participants as an MX message using either structured\n\t\t\t\t\t\tpostal address formatting or hybrid postal address formatting."
                    ]
                ]
            ]
        ) meta {
            html::attributes = {
                class = "pnz-table coexistence-table"
            }
        }
    } meta {
        html::attributes = {
            class = "table-scroll"
        }
    }
    div = [
        div = [
            span = "UG2025" meta {
                html::attributes = {
                    class = "doc-comment-id"
                }
            }
            span = "RK" meta {
                html::attributes = {
