    div = [
        div = [
            span = "UG2025" meta {
                html::attributes = {
                    class = "doc-comment-id"
                }
            }
            span = "RK" meta {
                html::attributes = {
                    class = "doc-comment-initials"
                }
            }
        ] meta {
            html::attributes = {
                class = "doc-comment-meta"
            }
        }
        div = [
            "Renamed:"
            "From: Cash management message scope"
        ] meta {
            html::attributes = {
                class = "doc-comment-content"
            }
        }
    ] meta {
        html::attributes = {
            class = "doc-comment"
            data-change-id = "UG2025"
        }
    }
    div = [
        div = [
            span = "UG2025" meta {
                html::attributes = {
                    class = "doc-comment-id"
                }
            }
            span = "RK" meta {
                html::attributes = {
                    class = "doc-comment-initials"
                }
            }
        ] meta {
            html::attributes = {
                class = "doc-comment-meta"
            }
        }
        div = [
            "Revised coexistence requirements per SWIFT's latest requirements."
        ] meta {
            html::attributes = {
                class = "doc-comment-content"
            }
        }
    ] meta {
        html::attributes = {
            class = "doc-comment"
            data-change-id = "UG2025"
        }
    }
    div = [
        "The following investigation messages are in scope during the co-existence phase:"
    ]
    div = {
        ;table = #table(
            type table {
                ;MT message = any
                ;MX message = any
                ;NZ HVCS timing = any
                ;(CBPR+ timing) = any
            }
            [
                [
                    "MT 192 / 292 - Request for Cancellation"
                    "camt.056 - FI to FI Cancellation Request"
                    [
                        div = [
                            "By the beginning of the co-existence phase:"
                        ] meta {
                            html::attributes = {
                                class = "bold"
                            }
                        }
                        div = [
                            "Participants must be able to receive from SWIFT as an MX message and process"
                        ]
                        div = [
                            "By the end of the co-existence phase:"
                        ] meta {
                            html::attributes = {
                                class = "bold"
                            }
                        }
                        div = [
                            "Participants must send all requests as an MX message."
                        ]
                    ]
                    [
                        div = [
                            "By the beginning of the co-existence phase:"
                        ] meta {
                            html::attributes = {
                                class = "bold"
                            }
                        }
                        div = [
                            "Participants acting as intermediaries must accept CBPR+ camt.056 messages.\n\t\t\t\t\t\t\tMX->MT and MT->MX translation will be available via SWIFT's Inflow Translation."
                        ]
                        div = [
                            "By the end of the co-existence phase:"
                        ] meta {
                            html::attributes = {
                                class = "bold"
                            }
                        }
                        div = [
                            "Participants must send all requests to SWIFT's Case Manager BIC."
                        ]
                    ]
                ]
                [
                    "MT 196 / 296 - Answers"
                    "camt.029 - Resolution of Investigation"
                    [
                        div = [
                            "By the beginning of the co-existence phase:"
                        ] meta {
                            html::attributes = {
                                class = "bold"
                            }
                        }
                        "Participants must be able to receive from SWIFT as an MX message and process"
                        br = null
                        div = [
                            "By the end of the co-existence phase:"
                        ] meta {
                            html::attributes = {
                                class = "bold"
                            }
                        }
                        div = [
                            "Participants must send all responses as an MX message."
                        ]
                    ]
                    [
                        div = [
                            "By the beginning of the co-existence phase:"
                        ] meta {
                            html::attributes = {
                                class = "bold"
                            }
                        }
                        "Participants acting as intermediaries must accept CBPR+ camt.029.  MX->MT and MT->MX\n\t\t\t\t\t\ttranslation will be available via SWIFT's In-Flow Translation."
                        br = null
                        div = [
                            "By the end of the co-existence phase:"
                        ] meta {
                            html::attributes = {
                                class = "bold"
                            }
                        }
                        "Participants must send all responses to SWIFT's Case Manager BIC."
                    ]
                ]
                [
                    "MT 199 / MT 299 - Investigation Request and Response"
                    "camt.110 / camt.111 - Investigation Request and Response"
                    [
                        div = [
                            "No decision has been taken in relation to use of camt.110/camt.111 for domestic payments."
                        ] meta {
                            html::attributes = {
                                class = "bold"
                            }
                        }
                        "Payments NZ will lead assessment of Case Manager capabilities for domestic\n\t\t\t\t\t\tpayments when SWIFT make this capability available for testing."
                    ]
                    [
                        div = [
                            "By the end of the co-existence phase:"
                        ] meta {
                            html::attributes = {
                                class = "bold"
                            }
                        }
                        "Participants must be able to receive from SWIFT and process as an MX message"
                    ]
                ]
            ]
        ) meta {
            html::attributes = {
                class = "pnz-table coexistence-table"
            }
        }
    } meta {
        html::attributes = {
            class = "table-scroll"
        }
    }
    div = [
        div = [
            span = "UG2025" meta {
                html::attributes = {
                    class = "doc-comment-id"
                }
            }
            span = "RK" meta {
                html::attributes = {
                    class = "doc-comment-initials"
                }
            }
        ] meta {
            html::attributes = {
                class = "doc-comment-meta"
            }
        }
        div = [
            "Revised timing, replaced diagram."
        ] meta {
            html::attributes = {
                class = "doc-comment-content"
            }
        }
    ] meta {
        html::attributes = {
            class = "doc-comment"
            data-change-id = "UG2025"
        }
    }
    div = [
        div = "ISO 20022 migration timeline" meta {
            html::attributes = {
                id = "1.5-iso-20022-migration-timeline"
                class = "clause-heading"
                data-number = "1.5"
            }
        }
        div = [
            "A phased adoption of MX Messaging Procedures will begin on 22 November 2025."
        ] meta {
            html::attributes = {
                class = "level1"
            }
        }
    ] meta {
        html::attributes = {
            class = "clause-row"
        }
