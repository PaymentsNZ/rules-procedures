                        class = "doc-comment-meta"
                    }
                }
                div = [
                    "Added ICBC, NZ Depository"
                ] meta {
                    html::attributes = {
                        class = "doc-comment-content"
                    }
                }
            ] meta {
                html::attributes = {
                    class = "doc-comment"
                    data-change-id = "UG2025"
                }
            }
            div = {
                ;table = #table(
                    type table {
                        Participants = any
                        Date = any
                    }
                    [
                        [ "ANZ Bank New Zealand Limited", "1 October 2010" ]
                        [ "ASB Bank Ltd", "1 October 2010" ]
                        [ "Bank of China (New Zealand) Limited", "4 December 2020" ]
                        [ "Bank of New Zealand", "1 October 2010" ]
                        [ "Citibank, N.A.", "1 October 2010" ]
                        [ "HSBC", "1 October 2010" ]
                        [ "Industrial and Commercial Bank of China (New Zealand) Limited", "26 March 2025" ]
                        [ "New Zealand Depository Limited", "4 August 2025" ]
                        [ "Westpac New Zealand Limited", "1 October 2010" ]
                    ]
                ) meta {
                    html::attributes = {
                        class = "pnz-table"
                    }
                }
            } meta {
                html::attributes = {
                    class = "table-scroll"
                }
            }
        ] meta {
            html::attributes = {
                class = "level1"
            }
        }
    ] meta {
        html::attributes = {
            class = "clause-row"
        }
    }
