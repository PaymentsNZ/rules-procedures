[
    div = {
        img = "" meta {
            html::attributes = {
                src = "../images/PNZ_OnWhite_rgb.gif"
                alt = "PNZ Logo"
            }
        }
    } meta {
        html::attributes = {
            class = "logo"
        }
    }
    [
        div = "Appendix 14B: HVCS Common Procedures (UG2025)" meta {
            html::attributes = {
                class = "document-title"
            }
        }
        div = "Version 2" meta {
            html::attributes = {
                class = "document-meta"
            }
        }
        div = "Effective date: 22/11/2025" meta {
            html::attributes = {
                class = "document-meta"
            }
        }
    ]
    h1 = "Document purpose and overview" meta {
        html::attributes = {
            id = "document-purpose-and-overview"
            class = "section-heading"
        }
    }
    div = "" meta {
        html::attributes = {
            class = "tag-commentary"
        }
    }
    div = [
        div = "HVCS rules and procedures overview" meta {
            html::attributes = {
                id = "hvcs-rules-and-procedures-overview"
                class = "clause-heading"
                data-number = ""
            }
        }
        ol = [
            div = [
                "This document HVCS Common Procedures (Part B) is one part of a suite of documentation to help\n\t\t\tparticipants understand what is required to become a high value clearing system (HVCS) participant\n\t\t\tand how to send and receive individual HVCS instructions and NZD HVCS payments that the participant\n\t\t\tcannot revoke or reverse after settlement."
            ]
        ] meta {
            html::attributes = {
                class = "level1 level1-counter-reset"
            }
        }
    ] meta {
        html::attributes = {
            class = "clause-row"
        }
    }
    [
        div = [
            div = [
                "Payments NZ Rules"
                "Part 9"
                "HVCS Clearing and Settlement"
            ] meta {
                html::attributes = {
                    class = "menu-root"
                }
            }
            div = [
                a = [
                    "Part A"
                    "HVCS Overview"
                ] meta {
                    html::attributes = {
                        href = "overview.html"
                        class = "menu-branch"
                    }
                }
                a = [
                    "Part B"
                    "HVCS Common Procedures"
                ] meta {
                    html::attributes = {
                        href = "common.html"
                        class = "menu-branch active"
                    }
                }
                a = [
                    "Part C"
                    "SCP Procedures"
                ] meta {
                    html::attributes = {
                        href = "scp.html"
                        class = "menu-branch"
                    }
                }
                a = [
                    "Part D"
                    "MX Messaging Procedures (ISO 20022)"
                ] meta {
                    html::attributes = {
                        href = "mx.html"
                        class = "menu-branch"
                    }
                }
                a = [
                    "Part E"
                    "MT Messaging Procedures (ISO 15022)"
                ] meta {
                    html::attributes = {
                        href = "mt.html"
                        class = "menu-branch"
                    }
                }
                a = [
                    "Part F"
                    "Co-existence Procedures"
                ] meta {
                    html::attributes = {
                        href = "coexistence.html"
                        class = "menu-branch"
                    }
                }
            ] meta {
                html::attributes = {
                    class = "menu-branches"
                }
            }
        ] meta {
            html::attributes = {
                class = "menu-container"
            }
        }
        div = "Diagram 01: HVCS Rules and Procedures documentation structure" meta {
            html::attributes = {
                class = "menu-caption"
            }
        }
    ]
    div = [
        div = "" meta {
            html::attributes = {
                id = ""
                class = "clause-heading"
                data-number = ""
            }
        }
        ol = [
            div = [
                "This document should be read in conjunction with the Payments NZ Rules (in particular, Part 9).\n\t\t\tPart 9 contains the HVCS clearing and settlement rules which specify the requirements for participants\n\t\t\tto create, exchange, settle, deliver and receive HVCS instructions and make HVCS payments (including SCPs)\n\t\t\tthrough HVCS. Part 2 contains the access and participation rules for an entity to join HVCS."
                "In addition to the Rules, the applicable HVCS standards (Appendix 14) which specify how participants\n\t\t\tcomply with Part 9 are comprised of:"
                ul = [
                    "Part A — HVCS Overview"
                    ul = [
                        "Provides a high-level overview of the HVCS community, message types, how HVCS clearing and\n\t\t\t\t\tsettlement works, and the business, technical, and regulatory environment in which the process\n\t\t\t\t\toperates.  This is a non-binding document for use as guidance only."
                    ]
                    "Part B — HVCS Common Procedures (this document)"
                    ul = [
                        "Provides binding procedures and product requirements that apply to all HVCS instructions at all\n\t\t\t\t\ttimes.  This document also contains some non-binding commentary and best practice."
                    ]
                    "Part C — SCP Procedures"
                    ul = [
                        "Provides binding procedures and product requirements that apply only to an HVCS instruction that\n\t\t\t\t\tis a same day cleared payment.  This document also contains some non-binding commentary and best\n\t\t\t\t\tpractice, such as recommended terms and conditions with customers."
                    ]
                    "Part D — MX Messaging Procedures"
                    ul = [
                        "Provides binding procedures on how to send and receive MX messages (ie, NZ HVCS ISO 20022\n\t\t\t\t\tmessages) across the HVCS MX CUG.  This document also contains some non-binding commentary and\n\t\t\t\t\tbest practice."
                    ]
                    "Part E — MT Messaging Procedures"
                    ul = [
                        "Provides binding procedures on how to send and receive MT messages (ie, NZ HVCS ISO 15022\n\t\t\t\t\tmessages) across the HVCS MT CUG.  This document also contains some non-binding commentary and\n\t\t\t\t\tbest practice."
                    ]
                    "Part F — Co-existence Procedures"
                    ul = [
                        "Provides binding procedures for participants during the co-existence phase of the migration from\n\t\t\t\t\tsending and receiving MT messages to MX messages."
                    ]
                ] meta {
                    html::attributes = {
                        class = "bullets"
                    }
                }
            ]
        ] meta {
            html::attributes = {
                class = "level1 level1-counter-reset"
            }
        }
    ] meta {
        html::attributes = {
            class = "clause-row"
        }
    }
    div = [
        div = "Standards, best practices and commentary" meta {
            html::attributes = {
                id = "standards-best-practices-and-commentary"
                class = "clause-heading"
                data-number = ""
            }
        }
        ol = [
            p = [
                "For information on how to determine whether the content of an applicable HVCS standard in Appendix 14\n\t\t\tcreates binding legal rights or obligations, please see"
                span = "Part A - Overview." meta {
                    html::attributes = {
                        class = "italic"
                    }
                }
            ]
        ] meta {
            html::attributes = {
                class = "level1 level1-counter-reset"
            }
        }
    ] meta {
        html::attributes = {
            class = "clause-row"
        }
    }
    div = [
        div = "Document purpose and structure" meta {
            html::attributes = {
                id = "document-purpose-and-structure"
                class = "clause-heading"
                data-number = ""
            }
        }
        ol = [
            "This document discusses the HVCS Common Procedures that apply to normal processing of all HVCS instructions\n\t\tand the processing of errors and late HVCS payments."
            "This document is divided into three chapters."
            "Chapter 1 provides an overview on how to process HVCS instructions to settle and interchange HVCS payments\n\t\tunder normal conditions."
            "Chapter 2 specifies how to process HVCS instructions to settle and interchange HVCS payments that contain\n\t\terrors."
            "Chapter 3 specifies how to process HVCS instructions to settle and interchange HVCS payments that have been\n\t\tsettled after 16:45."
        ] meta {
            html::attributes = {
                class = "level1 level1-counter-reset"
            }
        }
    ] meta {
        html::attributes = {
            class = "clause-row"
        }
    }
    h1 = "Chapter 1: Normal HVCS processing" meta {
        html::attributes = {
            id = "chapter-1-normal-hvcs-processing"
            class = "section-heading"
        }
    }
    div = "" meta {
        html::attributes = {
            class = "tag-standards"
        }
    }
    div = [
        div = "Defined terms" meta {
            html::attributes = {
                id = "1.1-defined-terms"
                class = "clause-heading"
                data-number = "1.1"
            }
        }
        div = [
            div = [
                div = [
                    span = "UG2025" meta {
                        html::attributes = {
                            class = "doc-comment-id"
                        }
                    }
                    span = "RK" meta {
                        html::attributes = {
                            class = "doc-comment-initials"
                        }
                    }
                ] meta {
                    html::attributes = {
                        class = "doc-comment-meta"
                    }
                }
                div = [
                    "Changed capitalisation of FINplus"
                ] meta {
                    html::attributes = {
                        class = "doc-comment-content"
                    }
                }
            ] meta {
                html::attributes = {
                    class = "doc-comment"
                    data-change-id = "UG2025"
                }
            }
            [
                span = "CBPR+" meta {
                    html::attributes = {
                        class = "bold"
                    }
                }
                span = "means the ISO 20022-based messaging standard for sending a SWIFT message through the FINplus CUG\n\t\t\t\toperated by SWIFT."
            ]
            div = [
                div = [
                    span = "UG2025" meta {
                        html::attributes = {
                            class = "doc-comment-id"
                        }
                    }
                    span = "JW" meta {
                        html::attributes = {
                            class = "doc-comment-initials"
                        }
                    }
                ] meta {
                    html::attributes = {
                        class = "doc-comment-meta"
                    }
                }
                div = [
                    "Removed MT103"
                ] meta {
                    html::attributes = {
                        class = "doc-comment-content"
                    }
                }
            ] meta {
                html::attributes = {
                    class = "doc-comment"
                    data-change-id = "UG2025"
                }
            }
            [
                span = "Customer credit transfer message" meta {
                    html::attributes = {
                        class = "bold"
                    }
                }
                span = "means the following payment messages used to facilitate an HVCS payment involving a customer of a\n\t\t\t\tparticipant:"
                ul = [
                    "pacs.008"
                ] meta {
                    html::attributes = {
                        class = "bullets"
                    }
                }
            ]
            [
                span = "Exception and investigation message" meta {
                    html::attributes = {
                        class = "bold"
                    }
                }
                span = "message means an HVCS instruction sent between participants including:"
                ul = [
                    "MT192;"
                    "MT196"
                    "MT292;"
                    "MT296"
                    "camt.056; or"
                    "camt.029"
                ] meta {
                    html::attributes = {
                        class = "bullets"
                    }
                }
            ]
            div = [
                div = [
                    span = "UG2025" meta {
                        html::attributes = {
                            class = "doc-comment-id"
                        }
                    }
                    span = "JW" meta {
                        html::attributes = {
                            class = "doc-comment-initials"
                        }
                    }
                ] meta {
                    html::attributes = {
                        class = "doc-comment-meta"
                    }
                }
                div = [
                    "Removed MT202, MT202COV, MT205, MT205COV"
                ] meta {
                    html::attributes = {
                        class = "doc-comment-content"
                    }
                }
            ] meta {
                html::attributes = {
                    class = "doc-comment"
                    data-change-id = "UG2025"
                }
            }
            [
                span = "FI credit transfer message" meta {
                    html::attributes = {
                        class = "bold"
                    }
                }
                span = "means the following payment messages used to facilitate an HVCS payment involving a participant or\n\t\t\t\t financial institution customer of a participant:"
                ul = [
                    "pacs.009; and"
                    "pacs.009COV"
                ] meta {
                    html::attributes = {
                        class = "bullets"
                    }
                }
            ]
            [
                span = "FIN message" meta {
                    html::attributes = {
                        class = "bold"
                    }
                }
                span = "means the ISO 15022-based messaging standard for sending a SWIFT message through the general FIN CUG\n\t\t\t\toperated by SWIFT."
            ]
            [
                span = "MT message" meta {
                    html::attributes = {
                        class = "bold"
                    }
                }
                span = "means an HVCS instruction sent in accordance with the MT Messaging Procedures"
            ]
            [
                span = "MX message" meta {
                    html::attributes = {
                        class = "bold"
                    }
                }
                span = "means an HVCS instruction sent in accordance with the MX Messaging Procedures and the MX Message\n\t\t\t\tSpecifications"
            ]
            [
                span = "MX Message Specifications" meta {
                    html::attributes = {
                        class = "bold"
                    }
                }
                span = "means the applicable production version(s) of New Zealand's HVCS Usage Guidelines, being the base\n\t\t\t\tISO 20022 message specifications modified for New Zealand's HVCS and provided on the \"mystandards\"\n\t\t\t\twebpage"
            ]
            div = [
                div = [
                    span = "UG2025" meta {
                        html::attributes = {
                            class = "doc-comment-id"
                        }
                    }
                    span = "JW" meta {
                        html::attributes = {
                            class = "doc-comment-initials"
                        }
                    }
                ] meta {
                    html::attributes = {
                        class = "doc-comment-meta"
                    }
                }
                div = [
                    "Removed MT103 RETN, MT202 RETN, MT202COV RETN, MT205 RETN, and MT205COV RETN"
                ] meta {
                    html::attributes = {
                        class = "doc-comment-content"
                    }
                }
            ] meta {
                html::attributes = {
                    class = "doc-comment"
                    data-change-id = "UG2025"
                }
            }
            [
                span = "Return message" meta {
                    html::attributes = {
                        class = "bold"
                    }
                }
                span = "message means the following payment messages used to facilitate the return of an HVCS payment:"
                ul = [
                    "pacs.004"
                ] meta {
                    html::attributes = {
                        class = "bullets"
                    }
                }
            ]
            [
                span = "SWIFT message" meta {
                    html::attributes = {
                        class = "bold"
                    }
                }
                span = "message means messages that are sent through SWIFT including:"
                ul = [
                    "HVCS instruction;"
                    "HVPS message;"
                    "CBPR+; or"
                    "FIN message"
                ] meta {
                    html::attributes = {
                        class = "bullets"
                    }
                }
            ]
            div = [
                div = [
                    span = "UG2025" meta {
                        html::attributes = {
                            class = "doc-question-id"
                        }
                    }
                    span = "JW" meta {
                        html::attributes = {
                            class = "doc-question-initials"
                        }
                    }
                ] meta {
                    html::attributes = {
                        class = "doc-question-meta"
                    }
                }
                div = [
                    "Is it safe to remove:"
                    "- MT010 - Non-Delivery Warning - a message that was being monitored in case of non-delivery, was not delivered before its obsolescence period expired."
                    "- MT011 - Delivery Notification - a message being monitored for delivery has actually been delivered."
                    "- MT019 - Abort Notification -  notifies the sender that the system has been unable to deliver the message specified in the <text-block>, and has been forced to abort it instead."
                ] meta {
                    html::attributes = {
                        class = "doc-question-content"
                    }
                }
            ] meta {
                html::attributes = {
                    class = "doc-question"
                    data-change-id = "UG2025"
                }
            }
            div = [
                div = [
                    span = "UG2025" meta {
                        html::attributes = {
                            class = "doc-comment-id"
                        }
                    }
                    span = "RK" meta {
                        html::attributes = {
                            class = "doc-comment-initials"
                        }
                    }
                ] meta {
                    html::attributes = {
                        class = "doc-comment-meta"
                    }
                }
                div = [
                    "Removed:"
                    "- MT012 - Sender Notification - an optional feature in the FIN Copy and FIN Inform service. It notifies the sender when the message has been released by the service administrator."
                ] meta {
                    html::attributes = {
                        class = "doc-comment-content"
                    }
                }
            ] meta {
                html::attributes = {
                    class = "doc-comment"
                    data-change-id = "UG2025"
                }
            }
            [
                span = "System message" meta {
                    html::attributes = {
                        class = "bold"
                    }
                }
                span = "means a message sent to a participant through SWIFT in relation to an HVCS instruction including:"
                ul = [
                    "MT010;"
                    "MT011;"
                    "MT019;"
                    "xsys.002;"
                    "xsys.003;"
                    "xsys.010; or"
                    "xsys.011"
                ] meta {
                    html::attributes = {
                        class = "bullets"
                    }
                }
            ]
            "Unless the context otherwise specifies, all other defined terms have the meanings given to them in Part 19\n\t\tof the Payments NZ Rules."
        ] meta {
            html::attributes = {
                class = "level1"
            }
        }
    ] meta {
        html::attributes = {
            class = "clause-row"
        }
    }
    div = [
        div = "Form, content, and delivery of payment instruction" meta {
            html::attributes = {
                id = "1.2-form-content-and-delivery-of-payment-instruction"
                class = "clause-heading"
                data-number = "1.2"
            }
        }
        div = [
            "The instructing agent that sends an HVCS instruction may determine the form, content, and method of delivery\n\t\tof the payment instruction from the debtor to the instructing agent."
        ] meta {
            html::attributes = {
                class = "level1"
            }
        }
    ] meta {
        html::attributes = {
            class = "clause-row"
        }
    }
    div = [
        div = "Agency arrangement obligations" meta {
            html::attributes = {
                id = "1.3-agency-arrangement-obligations"
                class = "clause-heading"
                data-number = "1.3"
            }
        }
        ol = [
            "A participant that receives HVCS instructions on behalf of a creditor agent pursuant to an agency arrangement\n\t\tmust ensure that each creditor agent which it has an agency arrangement with has a SWIFT BIC to identify the\n\t\tcreditor agent that can be provided to the debtor for inclusion in the details of the debtor's payment\n\t\tinstruction."
            "A participant that sends HVCS instructions on behalf of a debtor agent pursuant to an agency arrangement must\n\t\tensure that each debtor agent which it has an agency arrangement with has a SWIFT BIC that can be used by the\n\t\tParticipant acting as an instructing agent to identify the debtor agent within the payment message."
        ] meta {
            html::attributes = {
                class = "level1 level1-counter-reset"
            }
        }
    ] meta {
        html::attributes = {
            class = "clause-row"
        }
    }
    div = [
        div = "HVCS operating times" meta {
            html::attributes = {
                id = "1.4-hvcs-operating-times"
                class = "clause-heading"
                data-number = "1.4"
            }
        }
        ol = [
            "An HVCS participant must connect to the transaction delivery system—"
            ol = [
                "every business day including every provincial holiday; and"
                "during the minimum time period commencing at 09:00 on a business day and ending at 17:15 on that business\n\t\t\tday; and"
                "during a time period from 17:15 on a business day until such time as is necessary to receive any HVCS\n\t\t\tinstruction sent in accordance with clause 3.3 or 3.4 of these HVCS Common Procedures."
            ] meta {
                html::attributes = {
                    class = "level2 level2-counter-reset"
                }
            }
            "The instructing agent may only send an HVCS instruction during the time period commencing at 09:00 on a\n\t\tbusiness day and ending at 16:45 on that business day unless clause 3.3 or 3.4 of these HVCS Common Procedures\n\t\tapply."
        ] meta {
            html::attributes = {
                class = "level1 level1-counter-reset"
            }
        }
    ] meta {
        html::attributes = {
            class = "clause-row"
        }
    }
    div = "" meta {
        html::attributes = {
            class = "tag-commentary"
        }
    }
    div = [
        div = "Validating HVCS payments" meta {
            html::attributes = {
                id = "1.5-validating-hvcs-payments"
                class = "clause-heading"
                data-number = "1.5"
            }
        }
        ol = [
            "The following table sets out the validation requirements that apply to a range of HVCS instructions."
            "For clarity, the obligations set out in the table below are cumulative.  Participants must comply with every\n\t\tvalidation obligation that applies to the type of HVCS instruction that the participant sends or receives."
            h2 = "Instructing Agent" meta {
                html::attributes = {
                    id = "instructing-agent"
                    class = "subsection-heading"
                }
            }
            div = [
                div = [
                    span = "UG2025" meta {
                        html::attributes = {
                            class = "doc-comment-id"
                        }
                    }
                    span = "RK" meta {
                        html::attributes = {
                            class = "doc-comment-initials"
                        }
                    }
                ] meta {
                    html::attributes = {
                        class = "doc-comment-meta"
                    }
                }
                div = [
                    "Removed MT Obligations"
                ] meta {
                    html::attributes = {
                        class = "doc-comment-content"
                    }
                }
            ] meta {
                html::attributes = {
                    class = "doc-comment"
                    data-change-id = "UG2025"
                }
            }
            div = {
                ;table = #table(
                    type table {
                        Action = any
                        ;MX Obligations = any
                    }
                    [
                        [
                            [
                                span = "Sending an HVCS instruction as an"
                                span = "MX message" meta {
                                    html::attributes = {
                                        class = "bold"
                                    }
                                }
                            ]
                            [
                                "The instructing agent:"
                                ul = [
                                    [
                                        span = "Must" meta {
                                            html::attributes = {
                                                class = "bold"
                                            }
                                        }
                                        span = "validate the HVCS instruction in accordance with clause 2.1 and 2.2 of the MX\n\t\t\t\t\t\t\t\t\t\tMessaging Procedures (in accordance with MX Message Specifications MyStandards\n\t\t\t\t\t\t\t\t\t\tand Local Usage Guideline Validation); and"
                                    ]
                                    [
                                        span = "Should" meta {
                                            html::attributes = {
                                                class = "bold"
                                            }
                                        }
                                        span = "validate the HVCS instruction in accordance with clauses 8.2-8.3 of the MX\n\t\t\t\t\t\t\t\t\t\tMessaging Procedures"
                                    ]
                                ] meta {
                                    html::attributes = {
                                        class = "bullets"
                                    }
                                }
                                br = null
                                div = [
                                    "(MX Message Requirements)"
                                ] meta {
                                    html::attributes = {
                                        class = "italic"
                                    }
                                }
                                div = [
                                    "(Instructing Agent Validation)"
                                ] meta {
                                    html::attributes = {
                                        class = "italic"
                                    }
                                }
                                "Further information regarding usage guidelines can be found in clauses 8.2-8.3 of the\n\t\t\t\t\t\t\tMX procedures."
                                br = null
                                div = [
                                    "(Message Validation (Swift))"
                                ] meta {
                                    html::attributes = {
                                        class = "italic"
                                    }
                                }
                                div = [
                                    "(Message Validation (Participant))"
                                ] meta {
                                    html::attributes = {
                                        class = "italic"
                                    }
                                }
                            ]
                        ]
                        [
                            [
                                span = "Sending an HVCS instruction as an"
                                span = "SCP" meta {
                                    html::attributes = {
                                        class = "bold"
                                    }
                                }
                            ]
                            [
                                "The instructing agent:"
                                ul = [
                                    [
                                        span = "Must" meta {
                                            html::attributes = {
                                                class = "bold"
                                            }
                                        }
                                        span = "validate the HVCS instruction in accordance with clause 1.5 of the SCP Procedures"
                                    ]
                                    [
                                        span = "Must" meta {
                                            html::attributes = {
                                                class = "bold"
                                            }
                                        }
                                        span = "validate the HVCS instruction in accordance with clause 2.1 and 2.2 of the\n\t\t\t\t\t\t\t\t\t\tMX Messaging Procedures (in accordance with MX Message Specifications)"
                                    ]
                                ] meta {
                                    html::attributes = {
                                        class = "bullets"
                                    }
                                }
                            ]
                        ]
                        [
                            [
                                span = "Sending an HVCS instruction as an"
                                span = "Non-SCP" meta {
                                    html::attributes = {
                                        class = "bold"
                                    }
                                }
                            ]
                            [
                                "The instructing agent:"
                                ul = [
                                    [
                                        span = "Must" meta {
                                            html::attributes = {
                                                class = "bold"
