	pnz::subsection_heading( "MT202 and MT202COV" )

	pnz::clause(
		"5.4"
		"MT205"
		
		`A participant who sends or receives an MT205 message is a domestic financial institution who has
		agreed with the other participant who is party to the transaction to use the MT205 format.`
		
		`If a participant sends an MT205 using the AVP MT CUG transaction delivery system, the message may
		be a redirection of another category 2 message, for example, an MT200, MT201, MT202, or MT203,
		or MT205 received from overseas institution.`
		
		`The following standards apply to MT205s:`
		pnz::level2(
			`SWIFT's format and validation standards (refer to the SWIFT user handbook):`
			`the HVCS format and validation standards in the following table:`
		)
	)
	pnz::table(
		#table(
			[
				"Tag"
				"Field Name"
				"Content / options"
				"Status"
				"HVCS use"
			]
			[
				[
					"20"
					"Transaction reference number"
					"16x"
					"M"
					"Reference number assigned by instructing agent"
				]
				[
					"21"
					"Related reference"
					"16x"
					"M"
					"TRN of the related HVCS instruction or original message"
				]
				[
					"13C"
					"Time indication"
					"/8c/4!n1!x4!n"
					"O"
					"Do NOT use"
				]
				[
					"32A"
					"Value date /currency/ amount"
					"6!n3!a15d"
					"M"
					"HVCS payment Amount"
				]
				[
					"52a"
					"Ordering institution"
					"A or D"
					"O"
					"Refer to clause 5.6."
				]
				[
					"53a"
					"Instructing agent's correspondent"
					"A, B or D"
					"O"
					"Not allowed for HVCS"
				]
				[
					"56a"
					"Intermediary"
					"A or D"
					"O"
					"Not allowed for HVCS"
				]
				[
					"57a"
					"Account with institution"
					"A, B or D"
					"O"
					"Refer to clauses 5.7 and 5.8."
				]
				[
					"58a"
					"Beneficiary institution"
					"A or D"
					"M"
					"Refer to clauses 5.7 and 5.8"
				]
				[
					"72"
					"Instructing agent to instructed agent information"
					"6*35x"
					"O"
					"Refer to clauses 5.9 and 5.10."
				]
			]
		)
	)

