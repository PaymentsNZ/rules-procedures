namespace pnz.hvcs

import [
	html = "html.mixt"
	pnz = "pnz.legal.mixt"
]

{
	// pnz.hvcs::header
	pnz.hvcs::header = (docTitle as text, docIndex as number, docSet as list) => html::attributed(
		{
			class = "hvcs-header"
			role = "banner"
		}
		{
			div = html::attributed(
				{
					class = "hvcs-header-inner"
				}
				[
					a = html::attributed(
						{
							class = "hvcs-header-brandmark"
							href = "overview.html"
							aria-label = "Payments NZ Home"
						}
						{
							img = html::attributed(
								{
									src = "../images/PNZ_Brandmark_Black.png"
								}
								null
							)
						}
					)
					a = html::attributed(
						{
							class = "hvcs-header-logo"
							href = "overview.html"
							aria-label = "Payments NZ Home"
						}
						{
							img = html::attributed(
								{
									src = "../images/PNZ_OnBlack_rgb.gif"
									alt = ""
								}
								null
							)
						}
					)
					a = html::attributed(
						{
							class = "hvcs-header-title"
							href = "#"
						}
						docTitle
					)
					label = html::attributed(
						{
							for = "hvcs-menu-toggle"
							class = "hvcs-header-toggle"
           					aria-controls = "hvcs-toc"
						}
						"Contents"
					)
				]
			)
		}
	)

	// pnz.hvcs::nav
	pnz.hvcs::nav = (
		docTitle as text,
		chaptersAndClauses as list,
		docIndex as number,
		docSet as list
	) => html::attributed(
		{
			id = "hvcs-toc"
			class = "hvcs-toc"
			aria-label = "Table of contents"
		}
		[
			// Document switcher (optional if header switcher is shown)
			div = html::class(
				"toc-group toc-docs"
				[
					div = html::class( "toc-heading", "Documents" )
					ul = html::class(
						"toc-links"
						List.Transform(
							docSet
							(doc, i) => (
								let 
									target = doc[ target ]
									title = doc[ title ]
									transformed = #(li = {
										a = html::attributed(
											(
												if i == docIndex then
													{
														href = target
														class="active"
														aria-current="page"
													}
												else
													{
														href = target
													}
											)
											title
										)
									})
								in
									transformed
							)
						)
					)
				]
			)

			// Chapters
			div = html::class(
				"toc-group toc-chapters"
				[
					div = html::class( "toc-heading", "Chapters" )
				]
				&
				List.Transform(
					chaptersAndClauses
					(chapterAndClauses) => (
						#(details =
							[
								summary = chapterAndClauses[ Chapter ]
								ul = html::class(
									"toc-links"
									List.Transform(
										chapterAndClauses[ Clauses ]
										(clause, i, name) => #(li = {
											a = html::attributed(
												{
													href = pnz::href( name, clause, "#" )
												}
												(
													if name == "" then
														clause
													else
														$"$(name) $(clause)"
												)
											)	
										})
									)
								)
							]
						)
					)
				)
			)
		]
	)

	// pnz.hvcs::main
	pnz.hvcs::main = (
		docContent as list,
		chaptersAndClauses as list
	) => (
		let
			docMeta = Value.Metadata( docContent )
			docId = Record.FieldOrDefault( docMeta, "appendix", "?appendix?" )
			docTitle = Record.FieldOrDefault( docMeta, "title", "?title?" )
			docVersion = Record.FieldOrDefault( docMeta, "document_version", "?document_version?" )
			docEffectiveDate = Record.FieldOrDefault( docMeta, "effective_date", "?effective_date?" )
			docControl = Record.FieldOrDefault(
				docMeta
				"document_control"
				#table(
					[
						"Version number and description of amendment"
						"Amendment method and date"
						"Amendment notice date"
						"Effective date of amendment"
						"Authors"
					]
					[]
				)
			)

			completeContents = html::class(
				"hvcs-content"
				[
					div = html::attributed(
						{
							class = "pdf-vars"
						}
						[
							span = html::attributed(
								{
									id = "pdf-effective-date"
									class = "run-effdate"
								}
								$"Effective date: $(docEffectiveDate)"
							)
							span = html::attributed(
								{
									id = "pdf-doc-title"
									class = "run-doctitle"
								}
								$"Appendix $(docId): $(docTitle)"
							)
						]
					)
					pnz::logo
					pnz::document_title(
						$"Appendix $(docId): $(docTitle) (UG2025)"
						docVersion
						docEffectiveDate
					)
					html::class(
						"document-heading"
						"Document Control"
					)
					dl = html::class(
						"doc-meta"
						[
							dt = "Title"
							dd = docTitle
							dt = "Version"
							dd = docVersion
							dt = "Effective date"
							dd = docEffectiveDate
							dt = "Circulation"
							dd = "Payments NZ participants, Buddle Findlay, Reserve Bank"
						]
					)
					pnz::br
					"The following table summarises amendments to this document."
					pnz::br
					pnz::styled_table(
						"document-control-table"
						docControl
					)
				]
				& pnz::contents_table( chaptersAndClauses )
				& docContent
			)
		in
			completeContents
	)

	// pnz.hvcs::document creates a PNZ HVCS legal document as HTML
	pnz.hvcs::document = (
		docTitle as text,
		docContent as list,
		docIndex as number,
		chaptersAndClauses as list,
		docSet as list
	) => (
		html::document(
			"html",
			"en",
			// head (list)
			[
				;meta = html::meta( "UTF-8" )
				;meta = {
					html::attributes = {
						name = "viewport"
						content = "width=device-width, initial-scale=1"
					}
				} @> null
				title = docTitle
				link = html::stylesheet( "https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,400;0,700;1,400;1,700&display=swap" )
				link = html::stylesheet( "../styles/pnz.legal.css" )
				link = html::stylesheet( "../styles/pnz.hvcs.css" )
				link = html::stylesheet( "../styles/pnz.hvcs.menu.css" )
				link = html::stylesheet( "../styles/pnz.hvcs.nav.css" )						
				script =  html::attributed(
					{
						src = "../nav.js"
						defer = true
					}
					""
				)
			]
			// body (list)
			html::class(
				"document"
				[
					header = pnz.hvcs::header( docTitle, docIndex, docSet )
					// Mobile toggle (checkbox/label)
					input = html::attributed(
						{
							id = "hvcs-menu-toggle"
							;type = "checkbox"
							class = "hvcs-header-checkbox"
							hidden = true
						}
						null
					)
					nav = pnz.hvcs::nav( docTitle, chaptersAndClauses, docIndex, docSet )
					main = pnz.hvcs::main( docContent, chaptersAndClauses )
				]
			)
		)
	)

	menuClass = (currentIndex as UInt64.Type, activeIndex as UInt64.Type) => (
		if currentIndex == activeIndex then
			"menu-branch active"
		else
			"menu-branch"
	)
	pnz.hvcs::menu = (activeIndex as UInt64.Type) => [
		div = html::class(
			"menu-container"
			[
				div = html::class(
					"menu-root"
					[
						"Payments NZ Rules"
						"Part 9"
						"HVCS Clearing and Settlement"
					]
				)

				div = html::class(
					"menu-branches"
					[
						a = html::styled_link(
							"overview.html"
							menuClass( 0, activeIndex )
							[
								"Part A"
								"HVCS Overview"
							]
						)
						a = html::styled_link(
							"common.html"
							menuClass( 1, activeIndex )
							[
								"Part B"
								"HVCS Common Procedures"
							]
						)
						a = html::styled_link(
							"scp.html"
							menuClass( 2, activeIndex )
							[
								"Part C"
								"SCP Procedures"
							]
						)
						a = html::styled_link(
							"mx.html"
							menuClass( 3, activeIndex )
							[
								"Part D"
								"MX Messaging Procedures (ISO 20022)"
							]
						)
						a = html::styled_link(
							"mt.html"
							menuClass( 4, activeIndex )
							[
								"Part E"
								"MT Messaging Procedures (ISO 15022)"
							]
						)
						a = html::styled_link(
							"coexistence.html"
							menuClass( 5, activeIndex )
							[
								"Part F"
								"Co-existence Procedures"
							]
						)
					]
				)
			]
		)
		div = html::class(
			"menu-caption"
			"Diagram 01: HVCS Rules and Procedures documentation structure"
		)
	]
}
