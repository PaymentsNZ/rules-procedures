import [
	pnz = "../html/pnz.legal.mixt"
	hvcs = "../html/pnz.hvcs.mixt"
]

{
	appendix = "14B"
	title = "HVCS Common Procedures"
	document_version = "2"
	effective_date = "22/11/2025"
	document_control = #table(
		[
			"Version number and description of amendment"
			"Amendment method and date"
			"Amendment notice date"
			"Effective date of amendment"
			"Authors"
		]
		[
			[
				`Version 1: New document created as a result of restructure of the HVCS rules and standards
				to implement ISO 20022 MX messaging.`
				"Board resolution 21-Sep-2022"
				"21-Sep-2022"
				"20-Nov-2022"
				"Payments NZ, Buddle Findlay"
			]
			[
				`Version 2: Usage Guidelines 2025`
				"Board resolution 15-Sep-2025"
				"19-Sep-2025"
				"22-Nov-2025"
				"Payments NZ, Buddle Findlay"
			]			
		]
	)
} @> [
	pnz::section_heading( "Document purpose and overview" )
	pnz::tag_commentary

	pnz::clause(
		""
		"HVCS rules and procedures overview"

		pnz::nonumber(
			`This document HVCS Common Procedures (Part B) is one part of a suite of documentation to help
			participants understand what is required to become a high value clearing system (HVCS) participant
			and how to send and receive individual HVCS instructions and NZD HVCS payments that the participant
			cannot revoke or reverse after settlement.`
		)
	)

	hvcs::menu(1)

	pnz::clause(
		""
		""

		pnz::nonumber(
			`This document should be read in conjunction with the Payments NZ Rules (in particular, Part 9).
			Part 9 contains the HVCS clearing and settlement rules which specify the requirements for participants
			to create, exchange, settle, deliver and receive HVCS instructions and make HVCS payments (including SCPs)
			through HVCS. Part 2 contains the access and participation rules for an entity to join HVCS.`

			`In addition to the Rules, the applicable HVCS standards (Appendix 14) which specify how participants
			comply with Part 9 are comprised of:`

			pnz::bullets(
				`Part A — HVCS Overview`
				pnz::list(
					`Provides a high-level overview of the HVCS community, message types, how HVCS clearing and
					settlement works, and the business, technical, and regulatory environment in which the process
					operates.  This is a non-binding document for use as guidance only.`
				)

				`Part B — HVCS Common Procedures (this document)`
				pnz::list(
					`Provides binding procedures and product requirements that apply to all HVCS instructions at all
					times.  This document also contains some non-binding commentary and best practice.`
				)

				`Part C — SCP Procedures`
				pnz::list(
					`Provides binding procedures and product requirements that apply only to an HVCS instruction that
					is a same day cleared payment.  This document also contains some non-binding commentary and best
					practice, such as recommended terms and conditions with customers.`
				)

				`Part D — MX Messaging Procedures`
				pnz::list(
					`Provides binding procedures on how to send and receive MX messages (ie, NZ HVCS ISO 20022
					messages) across the HVCS MX CUG.  This document also contains some non-binding commentary and
					best practice.`
				)

				`Part E — MT Messaging Procedures`
				pnz::list(
					`Provides binding procedures on how to send and receive MT messages (ie, NZ HVCS ISO 15022
					messages) across the HVCS MT CUG.  This document also contains some non-binding commentary and
					best practice.`
				)

				`Part F — Co-existence Procedures`
				pnz::list(
					`Provides binding procedures for participants during the co-existence phase of the migration
					from sending and receiving MT messages to MX messages.`
				)
			)
		)
	)

	pnz::clause(
		""
		"Standards, best practices and commentary"

		pnz::nonumber_paragraph(
			`For information on how to determine whether the content of an applicable HVCS standard in Appendix 14
			creates binding legal rights or obligations, please see`
			pnz::italic( `Part A - Overview.` )
		)
	)

	pnz::clause(
		""
		"Document purpose and structure"

		`This document discusses the HVCS Common Procedures that apply to normal processing of all HVCS instructions
		and the processing of errors and late HVCS payments.`
		
		`This document is divided into three chapters.`
		
		`Chapter 1 provides an overview on how to process HVCS instructions to settle and interchange HVCS payments
		under normal conditions.`
		
		`Chapter 2 specifies how to process HVCS instructions to settle and interchange HVCS payments that contain
		errors.`
		
		`Chapter 3 specifies how to process HVCS instructions to settle and interchange HVCS payments that have been
		settled after 16:45.`
	)

	pnz::section_heading( "Chapter 1: Normal HVCS processing" )
	pnz::tag_standards

	pnz::nonumber_clause(
		"1.1"
		"Defined terms"

		[
			pnz::bold( "CBPR+" )
			pnz::text(
				`means the ISO 20022-based messaging standard for sending a SWIFT message through the FINplus CUG
				operated by SWIFT.`
			)
		]
		[
			pnz::bold( "Customer credit transfer message" )
			pnz::text(
				`means the following payment messages used to facilitate an HVCS payment involving a customer of a
				participant:`
			)
			pnz::bullets(
				`pacs.008`
			)
		]
		[
			pnz::bold( "Exception and investigation message" )
			pnz::text(
				`means an HVCS instruction sent between participants including:`
			)
			pnz::bullets(
				`MT192;`
				`MT196`
				`MT292;`
				`MT296`
				`camt.056; or`
				`camt.029`
			)
		]
		[
			pnz::bold( "FI credit transfer message" )
			pnz::text(
				`means the following payment messages used to facilitate an HVCS payment involving a participant or
				 financial institution customer of a participant:`
			)
			pnz::bullets(
				`pacs.009; and`
				`pacs.009COV`
			)
		]
		[
			pnz::bold( "FIN message" )
			pnz::text(
				`means the ISO 15022-based messaging standard for sending a SWIFT message through the general FIN CUG
				operated by SWIFT.`
			)
		]
		[
			pnz::bold( "MT message" )
			pnz::text(
				`means an HVCS instruction sent in accordance with the MT Messaging Procedures`
			)
		]	
		[
			pnz::bold( "MX message" )
			pnz::text(
				`means an HVCS instruction sent in accordance with the MX Messaging Procedures and the MX Message
				Specifications`
			)
		]
		[
			pnz::bold( "MX Message Specifications" )
			pnz::text(
				`means the applicable production version(s) of New Zealand's HVCS Usage Guidelines, being the base
				ISO 20022 message specifications modified for New Zealand's HVCS and provided on the "mystandards"
				webpage`
			)
		]
		[
			pnz::bold( "Return message" )
			pnz::text(
				`means the following payment messages used to facilitate the return of an HVCS payment:`
			)
			pnz::bullets(
				`pacs.004`
			)
		]
		[
			pnz::bold( "SWIFT message" )
			pnz::text(
				`means messages that are sent through SWIFT including:`
			)
			pnz::bullets(
				`HVCS instruction;`
				`CBPR+; or`
				`FIN message`
			)
		]
		[
			pnz::bold( "System message" )
			pnz::text(
				`means a message sent to a participant through SWIFT in relation to an HVCS instruction including:`
			)
			pnz::bullets(
				`MT010;`
				`MT011;`
				`MT019;`
				`xsys.002;`
				`xsys.003;`
				`xsys.010; or`
				`xsys.011`
			)
		]

		`Unless the context otherwise specifies, all other defined terms have the meanings given to them in Part 19
		of the Payments NZ Rules.`
	)

	pnz::nonumber_clause(
		"1.2"
		"Form, content, and delivery of payment instruction"

		`The instructing agent that sends an HVCS instruction may determine the form, content, and method of delivery
		of the payment instruction from the debtor to the instructing agent.`
	)

	pnz::clause(
		"1.3"
		"Agency arrangement obligations"
		
		`A participant that receives HVCS instructions on behalf of a creditor agent pursuant to an agency arrangement
		must ensure that each creditor agent which it has an agency arrangement with has a SWIFT BIC to identify the
		creditor agent that can be provided to the debtor for inclusion in the details of the debtor's payment
		instruction.`
		
		`A participant that sends HVCS instructions on behalf of a debtor agent pursuant to an agency arrangement must
		ensure that each debtor agent which it has an agency arrangement with has a SWIFT BIC that can be used by the
		Participant acting as an instructing agent to identify the debtor agent within the payment message.`
	)

	pnz::clause(
		"1.4"
		"HVCS operating times"

		`An HVCS participant must connect to the transaction delivery system—`

		pnz::level2(
			`every business day including every provincial holiday; and`

			`during the minimum time period commencing at 09:00 on a business day and ending at 17:15 on that business
			day; and`

			`during a time period from 17:15 on a business day until such time as is necessary to receive any HVCS
			instruction sent in accordance with clause 3.3 or 3.4 of these HVCS Common Procedures.`
		)

		`The instructing agent may only send an HVCS instruction during the time period commencing at 09:00 on a
		business day and ending at 16:45 on that business day unless clause 3.3 or 3.4 of these HVCS Common Procedures
		apply.`
	)

	pnz::tag_commentary

	pnz::clause(
		"1.5"
		"Validating HVCS payments"

		`The following table sets out the validation requirements that apply to a range of HVCS instructions.`

		`For clarity, the obligations set out in the table below are cumulative.  Participants must comply with every
		validation obligation that applies to the type of HVCS instruction that the participant sends or receives.`

		pnz::subsection_heading( "Instructing Agent" )

		pnz::styled_table(
			"validation-table"
			#table(
				[
					"Action", "MX Obligations"
				]
				[
					// Row
					[
						// Col 1
						[
							pnz::text( `Sending an HVCS instruction as an` )
							pnz::bold( `MX message` )
						]
						// Col 2
						[
							`The instructing agent:`
							pnz::bullets(
								[
									pnz::bold( "Must" )
									pnz::text(
										`validate the HVCS instruction in accordance with clause 2.1 and 2.2 of the MX
										Messaging Procedures (in accordance with MX Message Specifications MyStandards
										and Local Usage Guideline Validation); and`
									)
								]
								[
									pnz::bold( "Should" )
									pnz::text(
										`validate the HVCS instruction in accordance with clauses 8.2-8.3 of the MX
										Messaging Procedures`
									)
								]
							)
							pnz::br
							pnz::italic_div( "(MX Message Requirements)" )
							pnz::italic_div( "(Instructing Agent Validation)" )
							`Further information regarding usage guidelines can be found in clauses 8.2-8.3 of the
							MX procedures.`
							pnz::br
							pnz::italic_div( "(Message Validation (Swift))" )
							pnz::italic_div( "(Message Validation (Participant))" )
						]
					]
					// Row
					[
						// Col 1
						[
							pnz::text( `Sending an HVCS instruction as an` )
							pnz::bold( `SCP` )
						]
						// Col 2
						[
							`The instructing agent:`
							pnz::bullets(
								[
									pnz::bold( "Must" )
									pnz::text(
										`validate the HVCS instruction in accordance with clause 1.5 of the SCP Procedures`
									)
								]
								[
									pnz::bold( "Must" )
									pnz::text(
										`validate the HVCS instruction in accordance with clause 2.1 and 2.2 of the
										MX Messaging Procedures (in accordance with MX Message Specifications)`
									)
								]
							)
						]
					]
					// Row
					[
						// Col 1
						[
							pnz::text( `Sending an HVCS instruction as an` )
							pnz::bold( `Non-SCP` )
						]
						// Col 2
						[
							`The instructing agent:`
							pnz::bullets(
								[
									pnz::bold( "Must" )
									pnz::text(
										`validate the HVCS instruction in accordance with clause 2.1 and 2.2 of the MX
										Messaging Procedures (in accordance with MX Message Specifications MyStandards
										and Local Usage Guideline Validation); and`
									)
								]
								[
									pnz::bold( "Should" )
									pnz::text(
										`validate the HVCS instruction in accordance with clauses 8.2-8.3 of the MX
										Messaging Procedures`
									)
								]
							)
							pnz::br
							pnz::italic_div( "(MX Message Requirements)" )
							pnz::italic_div( "(Instructing Agent Validation)" )
							`Further information regarding usage guidelines can be found in clauses 8.2-8.3 of the
							MX procedures.`
							pnz::br
							pnz::italic_div( "(Message Validation (Swift))" )
							pnz::italic_div( "(Message Validation (Participant))" )							
						]
					]
					// Row
					[
						// Col 1
						[
							pnz::text( `Sending an HVCS instruction` )
							pnz::bullets(
								[
									pnz::text("As an")
									pnz::bold("SCP")
									pnz::text("; and")
								]
								[
									pnz::text("Creditor identified by")
									pnz::bold("BIC")
								]
							)
						]
						// Col 2
						[
							[
								pnz::bold("XML Path")
								pnz::text("for Creditor BIC:")
							]
							pnz::br
							`/ Document / FIToFICstmrCdtTrf / CdtTrfTxInf / Cdtr / Id / OrgId / AnyBIC`
							pnz::br
							pnz::bold_div("Rules:")
							`HVCS_SDCL_BIC_Creditor_Account_Identification_1_FormalRule`
							`HVCS_SDCL_BIC_Creditor_Account_Identification_2_FormalRule`
							pnz::br
							[
								pnz::bold("XML Path")
								pnz::text("for Creditor Account ID:")
							]
							pnz::br
							`/ Document / FIToFICstmrCdtTrf / CdtTrfTxInf / CdtrAcct / Id / Othr / Id`
							pnz::br
							[
								pnz::bold("Rules:")
							]							
							pnz::br
							`HVCS_SDCL_BBAN_Creditor_Account_Identification_FormalRule`
						]
					]

					// Row
					[
						// Col 1
						[
							pnz::text( `Sending an HVCS instruction` )
							pnz::bullets(
								[
									pnz::text("As an")
									pnz::bold("SCP")
									pnz::text("; and")
								]
								[
									pnz::bold("Does not")
									pnz::text("contain a")
									pnz::bold("BIC")
									pnz::text("(contains an account number)")
								]
							)
						]
						// Col 2
						[
							`Clause 4.2 of the MX Procedures has commentary that documents what an account number
							should look like.`
							pnz::br
							pnz::italic_div( `(SCP account number format)` )
							pnz::br
							[
								pnz::bold("XML Path")
								pnz::text("for Creditor Account ID:")
							]
							pnz::br
							`/ Document / FIToFICstmrCdtTrf / CdtTrfTxInf / CdtrAcct / Id / Othr / Id`
							pnz::br
							`Clause 2.3 of the MX Procedures includes requirements for Bacho format.`
							pnz::br
							pnz::italic_div( `(Instructed agent validation)` )
							[
								pnz::bold("XML Path")
								pnz::text("for Creditor Name:")
							]
							pnz::br
							`/ Document / FIToFICstmrCdtTrf / CdtTrfTxInf / Cdtr / Nm`
						]
					]

					// Row
					[
						// Col 1
						[
							pnz::text( `Sending an HVCS instruction` )
							pnz::bullets(
								[
									pnz::text("As an")
									pnz::bold("SCP")
									pnz::text("; and")
								]
								[
									pnz::text("Includes an")
									pnz::bold("email address")
									pnz::text("for the beneficiary notification")
								]
							)
						]
						// Col 2
						[
							`Clause 4.3 of the MX Procedures shows the dedicated email address field.`
							pnz::br
							pnz::italic_div( "SCP Customer notifications)" )
							[
								pnz::bold("XML Path")
								pnz::text("for Email Address:")
							]
							pnz::br
							`/ Document / FIToFICstmrCdtTrf / CdtTrfTxInf / Cdtr / CtctDtls / EmailAdr`
						]
					]

					// Row
					[
						// Col 1
						[
							pnz::text( `Sending an HVCS instruction` )
							pnz::bullets(
								[
									pnz::text( "As a customer credit transfer message — " )
									pnz::bold( "cross border redirection" )
									pnz::text( "(as set out in clause 9.1(2)(a)(iii) of the Rules); and" )
								]
								[
									pnz::text( "Contains a" )
									pnz::bold( "BIC" )
								]
							)
						]
						// Col 2
						[
							[
								pnz::bold("XML Path")
								pnz::text("for Creditor BIC:")
							]
							pnz::br
							`/ Document / FIToFICstmrCdtTrf / CdtTrfTxInf / Cdtr / Id / OrgId / AnyBIC`
							pnz::br
							[
								pnz::bold("XML Path")
								pnz::text("for Creditor Account ID:")
							]
							pnz::br
							`/ Document / FIToFICstmrCdtTrf / CdtTrfTxInf / CdtrAcct / Id / Othr / Id`
							pnz::br
							pnz::bold_div( "Rules:" )
							`HVCS_SDCL_BBAN_Creditor_Account_Identification_FormalRule`
						]
					]

					// Row
					[
						// Col 1
						[
							pnz::text( `Sending an HVCS instruction` )
							pnz::bullets(
								[
									pnz::text( "As a customer credit transfer message — " )
									pnz::bold( "cross border redirection" )
									pnz::text( "(as set out in clause 9.1(2)(a)(iii) of the Rules); and" )
								]
								[
									pnz::text( "Does" )
									pnz::bold( "not" )
									pnz::text( "contain a" )
									pnz::bold( "BIC" )
									pnz::text( "(contains an account number)" )
								]
							)
						]
						// Col 2
						[
							[
								pnz::bold("XML Path")
								pnz::text("for Creditor BIC:")
							]
							pnz::br
							`/ Document / FIToFICstmrCdtTrf / CdtTrfTxInf / Cdtr / Id / OrgId / AnyBIC`
							pnz::br
							[
								pnz::bold("XML Path")
								pnz::text("for Creditor Account ID:")
							]
							pnz::br
							`/ Document / FIToFICstmrCdtTrf / CdtTrfTxInf / CdtrAcct / Id / Othr / Id`
							pnz::br
							pnz::bold_div( "Rules:" )
							`HVCS_SDCL_BBAN_Creditor_Account_Identification_FormalRule`
						]
					]

					// Row
					[
						// Col 1
						[
							pnz::text( "Sending an HVCS instruction as an" )
							pnz::bold( "FI credit transfer message" )
							pnz::text( 
								`(as set out in clause 9.1(2)(b) of the Rules and as defined in the
								HVCS Common Procedures`
							)
						]
						// Col 2
						[
							[
								pnz::text("The instructing agent")
								pnz::bold("must")
								pnz::text(
