	pnz::br
	pnz::table(
		#table(
			[
				"Parameter"
				"Live"
				"Test and training"
			]
			[
				[
					"Value added service identifier"
					"AVP"
					"AVP"
				]
				[
					[
						"Live service flag"
						"(live = Y, T&T = N)"
					]
					"Y"
					"N"
				]
				[
					"Value added service number"
					"8"
					"7"
				]
				[
					"CID id"
					"ESASNZ2W"
					"ESASNZ20"
				]
				[
					[
						"Authentication mode"
						"(normal = 1, double = 2)"
					]
					"2"
					"2"
				]
				[
					[
						"Full copy flag"
						"(full copy = Y, part copy = N)"
					]
					"N"
					"N"
				]
				[
					[
						"Value date range"
						"(same day = 0, day n = n, no check=99)"
					]
					"99"
					"99"
				]
				[
					"Currency code"
					"NZD"
					"NZD"
				]
			]
		)
	)

	pnz::comment( "UG2025", "RK", "Removed: 'MT103 Parameter Table" )
	pnz::comment( "UG2025", "RK", "Removed: 'MT202 Parameter Table" )
	pnz::comment( "UG2025", "RK", "Removed: 'MT205 Parameter Table" )
	pnz::comment( "UG2025", "RK", "Removed: 'FIN Copy Parameter Table" )
