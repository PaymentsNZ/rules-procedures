            data-change-id = "UG2025"
        }
    }
    h1 = "Chapter 5: Formats for financial institution transfers" meta {
        html::attributes = {
            class = "section-heading"
        }
    }
    "This chapter has been deleted (UG2025 November 2025)."
    div = [
        div = [
            span = "UG2025" meta {
                html::attributes = {
                    class = "doc-question-id"
                }
            }
            span = "RK" meta {
                html::attributes = {
                    class = "doc-question-initials"
                }
            }
        ] meta {
            html::attributes = {
                class = "doc-question-meta"
            }
        }
        div = [
            "I am not sure we need to retain any of Chapter 6!"
            "If this chapter specifies the format for 2 of the notification message types that FINCopy\n\t\tsends to an instructing agent, and we are no longer using FINcopy, then we probably don't\n\t\tneed this at all."
            "We may just need to retain ESAS rejection codes."
        ] meta {
            html::attributes = {
                class = "doc-question-content"
            }
        }
    ] meta {
        html::attributes = {
            class = "doc-question"
            data-change-id = "UG2025"
        }
    }
    h1 = "Chapter 6: FINCopy system messages advising HVCS payment status" meta {
        html::attributes = {
            class = "section-heading"
        }
    }
    div = "" meta {
        html::attributes = {
            class = "tag-commentary"
        }
    }
    div = [
        div = "Purpose" meta {
            html::attributes = {
                class = "clause-heading"
                data-number = "6.1"
            }
        }
        ol = [
            div = [
                "This chapter specifies—"
            ]
            "the format for 2 of the notification message types that FINCopy sends to an instructing agent—"
            ol = [
                "an MT012 system message - instructing agent notification; and"
                "an MT019 system message - abort notification; and"
            ] meta {
                html::attributes = {
                    class = "level2 level2-counter-reset"
                }
            }
            "the ESAS rejection codes for AVP."
        ] meta {
            html::attributes = {
                class = "level1 level1-counter-reset"
            }
        }
    ] meta {
        html::attributes = {
            class = "clause-row"
        }
    }
    div = [
        div = "MT012: instructing agent notification" meta {
            html::attributes = {
                class = "clause-heading"
                data-number = "6.2"
            }
        }
        ol = [
            "FINCopy sends an MT012 system message to notify the instructing agent that FINCopy has released\n\t\tthe HVCS payment to the instructed agent. In AVP this occurs after the HVCS payment settles in ESAS."
            "If the instructing agent does not receive an MT012 system message from FINCopy by 17:15, the HVCS\n\t\tpayment may not have settled. If the instructing agent doesn't settle the HVCS payment by the end of\n\t\tthe ESAS day, ESAS will cancel the HVCS payment."
            "The following table specifies the format for an MT012 system message:"
            div = {
                ;table = #table(
                    type table {
                        Rep = any
                        Tag = any
                        Field = any
                        ;(Content/Comments) = any
                    }
                    [
                        [ "1", "175", "Time", "Input time (HHMM), local to the instructing agent, of the original user message." ]
                        [
                            "1"
                            "106"
                            "MIR"
                            "Message Input Reference (MIR) identifying the instructing agent's copy message copied to and released by the CSI."
                        ]
                        [ "0-1", "108", "MUR", "Message User Reference (MUR) used in the header of the original message." ]
                        [ "1", "102", "SWIFT address", "Destination BIC of the instructing agent's message. Includes the LT code." ]
                        [ "1", "103", "Service code", "AVP" ]
                        [
                            "1"
                            "114"
                            "Payment release information (instructing agent)"
                            [
                                "Information from central institution (SWIFT) to instructing agent of payment message\n\t\t\t\t\t\t\t(from field 114 of the MT097) as follows:"
                                ul = [
                                    "ESAS Date:"
                                    "ESAS Time:"
                                    "ESAS Reference Number."
                                ] meta {
                                    html::attributes = {
                                        class = "dashes"
                                    }
                                }
                            ]
                        ]
                    ]
                ) meta {
                    html::attributes = {
                        class = "pnz-table"
                    }
                }
            } meta {
                html::attributes = {
                    class = "table-scroll"
                }
            }
        ] meta {
            html::attributes = {
                class = "level1 level1-counter-reset"
            }
        }
    ] meta {
        html::attributes = {
            class = "clause-row"
        }
    }
    div = [
        div = "MT019: abort notification" meta {
            html::attributes = {
                class = "clause-heading"
                data-number = "6.3"
            }
        }
        ol = [
            "If an unsettled HVCS payment in ESAS is cancelled by the instructing agent or by ESAS (at 08:30 end\n\t\tof day), FINCopy notifies the instructing agent of the cancellation by sending an MT019 system\n\t\tmessage to the instructing agent."
            "An MT019 system message contains a code in field 432 specifying a reason for the abort."
            "If the HVCS payment was not settled by the 08:30am end of day,—"
            ol = [
                "ESAS will cancel the HVCS payment; and"
                "ESAS will send an abort notification MT019 system message (with error code 62 — Cancelled by ESAS\n\t\t\tend of day) to the instructing agent."
            ] meta {
                html::attributes = {
                    class = "level2 level2-counter-reset"
                }
            }
            "The following table specifies the format for an MT019 system message:"
            div = {
                ;table = #table(
                    type table {
                        Rep = any
                        Tag = any
                        Field = any
                        ;(Content/Comments) = any
                    }
                    [
                        [ "1", "175", "Time", "Input time (HHMM), local to the instructing agent, of the original user message." ]
                        [
                            "1"
                            "106"
                            "MIR"
                            "Message Input Reference (MIR) identifying the instructing agent's copy message\n\t\t\t\t\t\tcopied to and released by the CSI."
                        ]
                        [ "0-1", "108", "MUR", "Message User Reference (MUR) used in the header of the original message." ]
                        [
                            "1"
                            "102"
                            "SWIFT address"
                            [
                                ul = [
                                    "Destination BIC of the aborted message."
                                    "Includes the LT code."
                                ] meta {
                                    html::attributes = {
                                        class = "bullets"
                                    }
                                }
                            ]
                        ]
                        [
                            "0-1"
                            "107"
                            "MOR"
                            [
                                ul = [
                                    "Message Output Reference (MOR) of the aborted message."
                                    "If several delivery attempts have been made, field 107 contains the last valid MOR."
                                ] meta {
                                    html::attributes = {
                                        class = "bullets"
                                    }
                                }
                            ]
                        ]
                        [
                            "1"
                            "432"
                            "Abort reason"
                            "Refer to the table in clause 6.4 containing ESAS rejection codes and the\n\t\t\t\t\t\tSWIFT FIN error codes for the SWIFT generated codes returned in this field."
                        ]
                    ]
                ) meta {
                    html::attributes = {
                        class = "pnz-table"
                    }
                }
            } meta {
                html::attributes = {
                    class = "table-scroll"
                }
            }
        ] meta {
            html::attributes = {
                class = "level1 level1-counter-reset"
            }
        }
    ] meta {
        html::attributes = {
            class = "clause-row"
        }
    }
    div = [
        div = "ESAS rejection codes" meta {
            html::attributes = {
                class = "clause-heading"
                data-number = "6.4"
            }
        }
        div = [
            div = [
                div = [
                    span = "UG2025" meta {
                        html::attributes = {
                            class = "doc-comment-id"
                        }
                    }
                    span = "RK" meta {
                        html::attributes = {
                            class = "doc-comment-initials"
                        }
                    }
                ] meta {
                    html::attributes = {
                        class = "doc-comment-meta"
                    }
                }
                div = [
                    "Removed: ' (refer to Clause 1.4 Message lifecycle)'"
                ] meta {
                    html::attributes = {
                        class = "doc-comment-content"
                    }
                }
            ] meta {
                html::attributes = {
                    class = "doc-comment"
                    data-change-id = "UG2025"
                }
            }
            "The following table contains ESAS rejection codes for AVP and SBI and explanations of why ESAS applies\n\t\teach code when ESAS validates the structure of an MT096 system message but the content of the message\n\t\tfails business rules validation:"
        ] meta {
            html::attributes = {
                class = "level1"
            }
        }
    ] meta {
        html::attributes = {
            class = "clause-row"
        }
    }
    div = {
        ;table = #table(
            type table {
                Code = any
                ;Reason Type = any
                Summary = any
            }
            [
                [
                    "61"
                    "The payment cannot be validated because of some serious or fundamental problem with the message"
                    "The construction of the message does not conform to the ESAS application specifications."
                ]
                [
                    "62"
                    [
                        "AVP — Assured Value Payment"
                        "The payment instruction has one or more validation errors, such as:"
                    ] meta {
                        html::attributes = {
                            colspan = 2
                        }
                    }
                    ""
                ]
                [
                    "62.1"
                    "Duplicate tags"
                    [
                        "A payment instruction will be validated against the following:"
                        ul = [
                            "OCD — Originator BIC of the message (Instructing agent)"
                            "ODT — Originator Date (Calendar Date) when message is submitted"
                            "ORF — Originator Reference assigned by the settlement bank (MT Tag 20)"
                            "FSVD — Funds Settlement value day in the RTGS."
                        ] meta {
                            html::attributes = {
                                class = "bullets"
                            }
                        }
                        "Then, if the above conditions are the same as a previously processed message, and if\n\t\t\t\t\t\tBlock 4 (Tag 32A DATE/CCY/AMT) is different, the member will have an Error 62 - Duplicate\n\t\t\t\t\t\tTag returned."
                    ]
                ]
                [
                    "62.2"
                    "The Instructing or Instructed agents are inactivated or unknown."
                    "The instructing or instructed agent has been inactivated, or the BIC has not configured\n\t\t\t\t\tfor use in ESAS."
                ]
                [
                    "62.3"
                    "Invalid settlement date"
                    [
                        "The payment instruction Settlement Date must not exceed 14 business days from the date\n\t\t\t\t\t\tthe instruction was received in ESAS. The payment Settlement Date is a non-business date\n\t\t\t\t\t\tor a date in the past."
                    ]
                ]
                [
                    "62.4"
                    "Instructing agent failed to activate an instruction"
                    "The instructing agent does not activate the payment instruction in ESAS before end of day\n\t\t\t\t\t(only applicable to payments that have the payer-to-activate flag applied)."
                ]
                [ "62.5", "Invalid amount", "The payment instruction must be in NZD" ]
                [
                    "63"
                    "The payment was discarded due to insufficient funds (EOD cancellation)"
                    "Payment instruction did not settle before the EOD event started in ESAS."
                ]
                [
                    "65"
                    "The payment was removed by the Settlement Bank"
                    "The payment instruction was either removed or discarded from the ESAS by the Settlement Bank."
                ]
                [
                    "66"
                    "Duplicate SWIFT message — AVP (Assured Value Payment)"
                    [
                        "A payment instruction will be validated against the following:"
                        ul = [
                            "OCD — Originator BIC of the message (Instructing agent)"
                            "ODT — Originator Date (Calendar Date) when message is submitted"
                            "ORF — Originator Reference assigned by the settlement bank (MT Tag 20)"
                            "FSVD — Funds Settlement value day in the RTGS."
                        ] meta {
                            html::attributes = {
                                class = "bullets"
                            }
                        }
                        "Then, if the above conditions are the same, and if Block 4 (Tag 32A DATE/CCY/AMT) are\n\t\t\t\t\t\texactly the same, then the member will have an Error 66 Duplicate Instruction (Exact\n\t\t\t\t\t\tDuplicate) returned."
                    ]
                ]
                [
                    "66"
                    "Duplicate SWIFT message — SBI (Settlement Before Interchange)"
                    [
                        "A payment instruction will be validated against the following:"
                        ul = [
                            "ORF - Originator Reference = <FileId>"
                            "ODT - Originator date <IntrBkSttlmDt>"
                            "OCD - Originator BIC code - <Instructing agent><FullName><X1>"
                        ] meta {
                            html::attributes = {
                                class = "bullets"
                            }
                        }
                        "The system will check for duplicates according to the following logic:"
                        ul = [
                            "If the OCD, ORF and the ODT are the same as a previously processed instruction,\n\t\t\t\t\t\t\tthe system will reject the instruction immediately."
                            "If only the ORF is different, but the payment detail is the same as a previously\n\t\t\t\t\t\t\tprocessed instruction then the system will process the instruction."
                            "If only the OCD is different, but the payment detail is the same as a previously\n\t\t\t\t\t\t\tprocessed instruction then the system will process the instruction."
                        ] meta {
                            html::attributes = {
                                class = "bullets"
                            }
                        }
                        "The payment detail that is compared is the following:"
                        ul = [
                            "Instructing agent Reference - <Instructing agent Reference>"
                            "Originator Reference Number:<UserReference>"
                            "Beneficiary Bank: <Dbtr><BIC>"
                            "Paying bank: <Cdtr><BIC>"
                            "Amount: <TtlIntrBkSttlmAmt>"
                        ] meta {
                            html::attributes = {
                                class = "bullets"
                            }
                        }
                    ]
                ]
                [
                    "67"
                    "Discarded due to non-settlement day"
                    [
                        "The payment message must have a Settlement Date that is NZ business day for:"
                        [
                            div = [
                                div = [
                                    span = "UG2025" meta {
                                        html::attributes = {
                                            class = "doc-comment-id"
                                        }
                                    }
                                    span = "RK" meta {
                                        html::attributes = {
                                            class = "doc-comment-initials"
                                        }
                                    }
                                ] meta {
                                    html::attributes = {
                                        class = "doc-comment-meta"
                                    }
                                }
                                div = [
                                    "Removed: ', and until 21 April 2023, SBI."
                                ] meta {
                                    html::attributes = {
                                        class = "doc-comment-content"
                                    }
                                }
                            ] meta {
                                html::attributes = {
                                    class = "doc-comment"
                                    data-change-id = "UG2025"
                                }
                            }
                            ul = [
                                "AVP"
                            ] meta {
                                html::attributes = {
                                    class = "bullets"
                                }
                            }
                        ]
                    ]
                ]
            ]
        ) meta {
            html::attributes = {
                class = "pnz-table"
            }
        }
    } meta {
        html::attributes = {
            class = "table-scroll"
        }
    }
    br = null
    div = [
        "6.5 AVP MT CUG service parameters"
    ] meta {
        html::attributes = {
            class = "bold"
        }
