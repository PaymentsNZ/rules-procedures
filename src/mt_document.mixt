        div = "SWIFT message header details" meta {
            html::attributes = {
                class = "clause-heading"
                data-number = "2.1"
            }
        }
        div = [
            "A SWIFT message contains the following headers:"
            ul = [
                "block 1 = basic header:"
                "block 2 = application header:"
                "block 3 = user header:"
                "block 4 = text:"
                "block 5 = trailers."
            ] meta {
                html::attributes = {
                    class = "bullets"
                }
            }
        ] meta {
