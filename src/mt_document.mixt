    div = [
        div = "User header details" meta {
            html::attributes = {
                class = "clause-heading"
                data-number = "2.2"
            }
        }
        ol = [
            "The content and format of block 1 or block 2 is similar for all SWIFT messages (refer to the SWIFT\n\t\tUser Handbook)."
            "Block 3—"
            ol = [
                "is mandatory for all MT messages; and"
                "contains data that is specific to HVCS."
            ] meta {
                html::attributes = {
                    class = "level2 level2-counter-reset"
                }
            }
            [
                span = "The instructing agent of a payment message"
                span = "must" meta {
                    html::attributes = {
                        class = "bold"
                    }
                }
                span = "ensure that the service code (field tag 103) is AVP to ensure SWIFT know how\n\t\t\t\tto route the message through the RBNZ's CUG."
            ]
            div = [
                div = [
                    span = "UG2025" meta {
                        html::attributes = {
                            class = "doc-comment-id"
                        }
