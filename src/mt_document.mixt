                    }
                }
                div = [
                    "Is it correct to retain reference to 'HVCS instructions'?"
                    "Exception and investigation message means an HVCS instruction sent between participants\n\t\t\tincluding: MT192, MT196, MT292, MT296..."
                ] meta {
                    html::attributes = {
                        class = "doc-question-content"
                    }
                }
            ] meta {
                html::attributes = {
                    class = "doc-question"
                    data-change-id = "UG2025"
                }
            }
            div = [
                "This document MT Messaging Procedures (Part E) is one part of a suite of documentation to help participants\n\t\t\tunderstand what is required to become a high value clearing system (HVCS) participant and how to send and\n\t\t\treceive individual HVCS instructions that are exception and investigation messages."
            ]
        ] meta {
            html::attributes = {
                class = "level1 level1-counter-reset"
            }
        }
    ] meta {
        html::attributes = {
            class = "clause-row"
        }
    }
    [
        div = [
            div = [
                "Payments NZ Rules"
                "Part 9"
                "HVCS Clearing and Settlement"
            ] meta {
                html::attributes = {
                    class = "menu-root"
                }
            }
            div = [
                a = [
