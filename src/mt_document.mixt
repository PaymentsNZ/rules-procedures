                        class = "doc-comment-content"
                    }
                }
            ] meta {
                html::attributes = {
                    class = "doc-comment"
                    data-change-id = "UG2025"
                }
            }
            "This document discusses the MT Messaging Procedures that apply to HVCS instructions\n\t\tthat are exception and investigation messages."
            "This document is divided into six chapters (noting chapters 3, 4 and 5 have been deleted)."
            "Chapter 1 provides an overview of the MT messages that are in scope and the explains the\n\t\tmessage lifecycle."
            "Chapter 2 specifies how to format block 3 (user header) of the SWIFT message header."
            div = [
                div = [
                    span = "UG2025" meta {
                        html::attributes = {
                            class = "doc-comment-id"
                        }
                    }
                    span = "RK" meta {
                        html::attributes = {
                            class = "doc-comment-initials"
                        }
                    }
                ] meta {
                    html::attributes = {
                        class = "doc-comment-meta"
                    }
                }
                div = [
                    "Removed:"
                    "Chapter 3 specifies how to format customer credit transfers."
                    "Chapter 4 specifies how to format cross border redirections."
                    "Chapter 5 specifies how to format financial institution transfers."
                    "Added: 'Chapters 3, 4 and 5 have been deleted.'"
                ] meta {
                    html::attributes = {
                        class = "doc-comment-content"
                    }
                }
            ] meta {
                html::attributes = {
                    class = "doc-comment"
                    data-change-id = "UG2025"
                }
            }
            "Chapters 3, 4 and 5 have been deleted."
            div = [
