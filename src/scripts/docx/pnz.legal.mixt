namespace pnz.legal

meta {
}

import [
	"html.mixt"
	"docx.mixt"
]

{
	// pnz.legal::href creates a href from an id and title
	pnz.legal::href = (clauseNumber as text, title as text, prefix as text) => null

	// pnz.legal::document creates a PNZ legal document as HTML
	pnz.legal::document = (docTitle as text, docContent as list) => [
		docTitle
		docContent
	]

	// pnz.legal::document_title creates a document title
	pnz.legal::document_title = (title as text, version as text, effectiveDate as text ) => [
		title <@ {
			docx::class = "document-title"
		}
		$"Version $(version)" <@ {
			docx::class = "document-meta"
		}
		$"Effective date: $(effectiveDate)" <@ {
			docx::class = "document-meta"
		}
	]

	// pnz.legal::section_heading creates a section heading
	pnz.legal::section_heading = (content as any) => (
		docx::class( "section-heading", content )
	)

	// pnz.legal::subsection_heading creates a sub-section heading
	pnz.legal::subsection_heading = (content as any) => (
		docx::class( "subsection-heading", content )
	)

	// pnz.legal::tag_standards creates standards tag
	pnz.legal::tag_standards = (
		docx::class( "tag-standards", "" )
	)

	// pnz.legal::tag_bestpractice creates bestpractice tag
	pnz.legal::tag_bestpractice = (
		docx::class( "tag-bestpractice", "" )
	)

	// pnz.legal::tag_commentary creates commentary tag
	pnz.legal::tag_commentary = (
		docx::class( "tag-commentary", "" )
	)

	// pnz.legal::clause creates a clause with a header in the left column
	// clauses numbered with the style (1) (2)
	pnz.legal::clause = (id as text, heading as text, ...content as any) => (
		docx::class(
			"clause-row",
			[
				heading <@ {
					docx::class = "clause-heading"
				}

				content <@ {
					docx::level = 1
					docx::levelCounter1 = 1
				}
			]
		)
	)

	pnz.legal::nonumber_clause = (id as text, heading as text, ...content as any) => (
		docx::class(
			"clause-row",
			[
				heading <@ {
					docx::class = "clause-heading"
				}

				content
			]
		)
	)

	// pnz.legal::level1 creates indented clauses numbered with the style (1) (2)
	pnz.legal::level1 = (...content as any) => (
		content <@ {
			docx::level = 1
			docx::levelCounter2 = 1
		}
	)

	// pnz.legal::continue_level1 creates indented clauses numbered with the style (1) (2)
	pnz.legal::continue_level1 = (startNumber as number, ...content as any) => (
		content <@ {
			docx::level = 1
			docx::levelCounter1 = startNumber
		}		
	)

	// pnz.legal::level2 creates indented clauses numbered with the style (a) (b)
	pnz.legal::level2 = (...content as any) => (
		content <@ {
			docx::level = 2
			docx::levelCounter2 = 1
		}
	)

	// pnz.legal::continue_level2 creates indented clauses numbered with the style (a) (b)
	pnz.legal::continue_level2 = (startNumber as number, ...content as any) => (
		content <@ {
			docx::level = 2
			docx::levelCounter2 = startNumber
		}		
	)

	// pnz.legal::level3 creates indented clauses numbered with the style (i) (ii)
	pnz.legal::level3 = (...content as any) => (
		content <@ {
			docx::level = 3
			docx::levelCounter3 = 1
		}		
	)

	// pnz.legal::level3U creates indented clauses numbered with the style (I) (II)
	pnz.legal::level3U = (...content as any) => (
		content <@ {
			docx::level = 4
			docx::levelCounter4 = 1
		}
	)

	// pnz.legal::xml creates xml formatted content
	pnz.legal::xml = (...content as any) => (
		docx::class( "xml-snippet", content )
	)

	pnz.legal::table = (content as table) => #( table = content )

	pnz.legal::styled_table = (className as text, content as table) => #( table = 
		docx::class( className, content )
	)

	pnz.legal::definition_table = (...content as list) => #( table = 
		docx::class(
			"definition-table"
			content
		)
	)

	pnz.legal::br = #( br = null )

	pnz.legal::nonumber = (...content as any) => #( nonumber = content )

	// pnz.legal::nonumber_paragraph configures the content as a paragraph
	pnz.legal::nonumber_paragraph = (...content as any) => #( nonumber = content )

	// pnz.legal::paragraph configures the content as a paragraph
	pnz.legal::paragraph = (...content as any) => #( p = content )

	// pnz.legal::italic_div configures the content as a paragraph
	pnz.legal::italic_div = (...content as any) => (
		docx::class( "italic", content )
	)

	// pnz.legal::bold_div configures the content as a paragraph
	pnz.legal::bold_div = (...content as any) => (
		docx::class( "bold", content )
	)

	// pnz.legal::italic configures the content as a italic text
	pnz.legal::italic = (content as text) => (
		docx::class( "italic", content )
	)

	// pnz.legal::div configures the content as a paragraph
	pnz.legal::div = (...content as any) => (
		content
	)

	// pnz.legal::italic_item configures the content as a italic text
	pnz.legal::italic_item = (content as text) => (
		docx::class( "italic", content )
	)

	// pnz.legal::bold configures the content as a bold text
	pnz.legal::bold = (content as text) => (
		docx::class( "bold", content )
	)

	// pnz.legal::bold_italic configures the content as a bold italic text
	pnz.legal::bold_italic = (content as text) => (
		docx::class( "bold italic", content )
	)

	// pnz.legal::text configures the content as normal text
	pnz.legal::text = (content as text) => ( content )

	// pnz.legal::rowspan adds a rowspan attribute to table data
	pnz.legal::rowspan = (rowCount as UInt64.Type) => {
		docx::rowspan = rowCount
	}

	// pnz.legal::colspan adds a colspan attribute to table data
	pnz.legal::colspan = (colCount as UInt64.Type) => {
		docx::colspan = colCount
	}

	// pnz.legal::rowcolspan adds a rowspan and colspan attribute to table data
	pnz.legal::rowcolspan = (rowCount as UInt64.Type, colCount as UInt64.Type) => {
		docx::rowspan = rowCount
		docx::colspan = colCount
	}

	// pnz.legal::image inserts an image with alternate text
	pnz.legal::image = (src as text, alt as text) => ( null )

	// pnz.legal::image inserts an image with alternate text
	pnz.legal::logo = ( null )

	// pnz.legal::bullets sets the style of content to a bulleted list
	pnz.legal::bullets = (...content as any) => (
		docx::class( "bullets", content )
	)

	// pnz.legal::list configures the content as a list
	pnz.legal::list = (...content as any) => (
		docx::class( "list", content )
	)
	// pnz.legal::dashes sets the style of content to a bulleted list
	pnz.legal::dashes = (...content as any) => (
		docx::class( "dashes", content )
	)

	// pnz.legal::tick
	pnz.legal::tick = {
		docx::class = "tick"
	} @> "✓"

	// pnz.legal::cross
	pnz.legal::cross = {
		docx::class = "cross"
	} @> "✘"
}